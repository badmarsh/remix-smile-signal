  view_file {
    absolute_path_uri: "file:///src/components/TapeKitModal.tsx"
    start_line: 249
    end_line: 294
    content: "              Didaktik M \302\267 Kazetov\303\241 a hardv\303\251rov\303\241 sada\n            </h2>\n            <p className=\"mt-0.5 text-xs text-[#b5b2a9]\">\n              Vytvorte skuto\304\215n\303\272 magnetick\303\272 kazetu Z\303\272bok a sign\303\241lik pre microDENT.sk a TeatrO.eu \302\267 Kompatibiln\303\251 so Sinclair ZX Spectrum 48K ROM\n            </p>\n          </div>\n\n          <button\n            type=\"button\"\n            onClick={onClose}\n            aria-label=\"Zavrie\305\245 kazetov\303\272 sadu Didaktik M\"\n            className=\"flex h-10 min-w-[40px] cursor-pointer items-center justify-center whitespace-nowrap rounded-sm border border-[#525660] bg-[#13161e] px-3 font-mono text-xs font-semibold text-[#ebe9e3] hover:border-[#ffee00] hover:text-[#ffee00]\"\n          >\n            Zavrie\305\245\n          </button>\n        </div>\n\n        {/* Segmented Tabs */}\n        <div\n          className=\"flex items-center gap-1 overflow-x-auto border-b border-[#2b303c] bg-[#10131a] px-5 py-2.5\"\n          role=\"tablist\"\n        >\n          {(\n            [\n              { id: \'cassette\', label: \'Export na kazetu\' },\n              { id: \'udg\', label: \'Pixel Art (UDG)\' },\n              { id: \'sfx\', label: \'1-Bit Chiptune SFX\' },\n              { id: \'basic\', label: \'Sinclair BASIC\' },\n              { id: \'hardware\', label: \'Hardv\303\251r Didaktik M\' },\n            ] as const\n          ).map((tab) => (\n            <button\n              key={tab.id}\n              type=\"button\"\n              role=\"tab\"\n              aria-selected={activeTab === tab.id}\n              onClick={() => setActiveTab(tab.id)}\n              className={`min-h-[38px] shrink-0 cursor-pointer whitespace-nowrap rounded-sm px-3.5 py-1.5 font-mono text-xs font-semibold transition-colors ${\n                activeTab === tab.id\n                  ? \'bg-[#262c3a] text-[#00e8e8]\'\n                  : \'text-[#9ea3ae] hover:text-white\'\n              }`}\n            >\n              {tab.label}\n            </button>\n          ))}"
    num_lines: 673
    num_bytes: 30433
    line_range_bytes: 1932
  }
}
