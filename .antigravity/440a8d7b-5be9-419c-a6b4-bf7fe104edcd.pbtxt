    content: "/**\n * Authentic ZX Spectrum / Didaktik M pixel-art sprite bitmaps.\n * Z\303\272bok (smiling white molar tooth with crimson red scarf & red-accented sneakers),\n * Sign\303\241lik (retro robot buddy with dark visor, cyan ^ ^ smile & Wi-Fi antenna),\n * and the Golden-Star 1st Place MVP Plaque are crafted directly from the gift\'s pixel art.\n */\n\nimport { ZX_PALETTE } from \'../didaktik/specs\';\n\nexport type PixelPalette = Record<string, string>;\n\nexport interface PixelSprite {\n  rows: string[];\n  palette: PixelPalette;\n}\n\n/**\n * Z\303\232BOK \342\200\224 Frame A (Standing / Stride 1)\n * Crisp white tooth hero with black outline, happy eyes, crimson red scarf fluttering left,\n * dark charcoal limbs, and black-and-red sneakers.\n */\nexport const SPRITE_ZUBOK_A: PixelSprite = {\n  rows: [\n    \'....KKK.KKK...\',\n    \'...KWWWKWWWK..\',\n    \'...KWWWWWWWK..\',\n    \'...KWKWKWKWK..\',\n    \'...KWWWRWWWK..\',\n    \'.KKKRRRRRRRK..\',\n    \'KRRRRRRRRRRWK.\',\n    \'.KRRKWWWWWKWWK\',\n    \'..KKKWWWWWK.KK\',\n    \'....KWWKWWK...\',\n    \'....KWWKWWK...\',\n    \'...KDRK.KDRK..\',\n    \'..KDDDK.KDDDK.\',\n    \'..KKKKK.KKKKK.\',\n  ],\n  palette: {\n    K: ZX_PALETTE.black,\n    W: ZX_PALETTE.brightWhite,\n    R: ZX_PALETTE.brightRed,\n    D: ZX_PALETTE.blue,\n  },\n};\n\n/**\n * Z\303\232BOK \342\200\224 Frame B (Stride 2 / Scarf Flutter)\n */\nexport const SPRITE_ZUBOK_B: PixelSprite = {\n  rows: [\n    \'....KKK.KKK...\',\n    \'...KWWWKWWWK..\',\n    \'...KWWWWWWWK..\',\n    \'...KWKWKWKWK..\',\n    \'...KWWWRWWWK..\',\n    \'KKKKRRRRRRRK..\',\n    \'KRRRRRRRRRRWK.\',\n    \'.KRRKWWWWWKWWK\',\n    \'...KKWWWWWK.KK\',\n    \'....KWWKWWK...\',\n    \'...KWWK.KWWK..\',\n    \'..KDRK...KDRK.\',\n    \'..KDDK...KDDK.\',\n    \'..KKKK...KKKK.\',\n  ],\n  palette: {\n    K: ZX_PALETTE.black,\n    W: ZX_PALETTE.brightWhite,\n    R: ZX_PALETTE.brightRed,\n    D: ZX_PALETTE.blue,\n  },\n};\n\n/**\n * SIGN\303\201LIK \342\200\224 Frame A (Signal Antenna Wave 1)\n * Cute white/silver retro robot with dark visor, bright cyan ^ ^ happy eyes & smile,\n * glowing cyan antenna orb + Wi-Fi arcs, cyan chest LEDs, and silver boots.\n */\nexport const SPRITE_SIGNALIK_A: PixelSprite = {\n  rows: [\n    \'......KCK..C..\',\n    \'......KCK.C.C.\',\n    \'.......K..C.C.\',\n    \'...KKKKKKKK...\',\n    \'..KWWWWWWWWK..\',\n    \'.KWWKKKKKKWWK.\',\n    \'.KCKKCKKCKKCK.\',\n    \'.KWWKKCCKKWWK.\',\n    \'..KWWWWWWWWK..\',\n    \'..KWKWWWWKWK..\',\n    \'.KWWKWCCWKWWK.\',\n    \'..KKKWWWWKKK..\',\n    \'...KWWKKWWK...\',\n    \'..KSSSKKSSSK..\',\n  ],\n  palette: {\n    K: ZX_PALETTE.black,\n    W: ZX_PALETTE.brightWhite,\n    S: ZX_PALETTE.white,\n    C: ZX_PALETTE.brightCyan,\n  },\n};\n\n/**\n * SIGN\303\201LIK \342\200\224 Frame B (Signal Antenna Wave 2 / Hover Bob)\n */\nexport const SPRITE_SIGNALIK_B: PixelSprite = {\n  rows: [\n    \'......KCK.C...\',\n    \'......KCK..C..\',\n    \'.......K..C.C.\',\n    \'...KKKKKKKK...\',\n    \'..KWWWWWWWWK..\',\n    \'.KWWKKKKKKWWK.\',\n    \'.KCKKCKKCKKCK.\',\n    \'.KWWKKCCKKWWK.\',\n    \'..KWWWWWWWWK..\',\n    \'.KWWKWWWWKWWK.\',\n    \'..KKKWCCWKKK..\',\n    \'....KWWWWK....\',\n    \'..KWWK..KWWK..\',\n    \'.KSSSK..KSSSK.\',\n  ],\n  palette: {\n    K: ZX_PALETTE.black,\n    W: ZX_PALETTE.brightWhite,\n    S: ZX_PALETTE.white,\n    C: ZX_PALETTE.brightCyan,\n  },\n};\n\n/**\n * GOLDEN-STAR 1ST PLACE MVP PLAQUE (12x14)\n * Brushed silver plate framed in burnished gold with 4 corner rivets,\n * central golden 5-pointed star, and dark-gold stepped pedestal.\n */\nexport const SPRITE_MVP_PLAQUE: PixelSprite = {\n  rows: [\n    \'..KKKKKKKK..\',\n    \'.KYYYYYYYYK.\',\n    \'.KYKSSSSKYK.\',\n    \'.KYSYSSYSYK.\',\n    \'.KYSSYYSYYK.\',\n    \'.KYSYYYYYSK.\',\n    \'.KYSSYYSSYK.\',\n    \'.KYSYSYSYSK.\',\n    \'.KYSSSSSSYK.\',\n    \'.KYKSSSSKYK.\',\n    \'.KYYYYYYYYK.\',\n    \'.KKKKKKKKKK.\',\n    \'KDDYYYYYYDDK\',\n    \'KKKKKKKKKKKK\',\n  ],\n  palette: {\n    K: ZX_PALETTE.black,\n    Y: ZX_PALETTE.brightYellow,\n    S: ZX_PALETTE.white,\n    D: ZX_PALETTE.yellow,\n  },\n};\n\n/**\n * Dizzy / Towdie / Pedro Collectible Adventure Relic (10x10)\n */\nexport const SPRITE_RELIC_ARTIFACT: PixelSprite = {\n  rows: [\n    \'...KKKK...\',\n    \'..KYYYYK..\',\n    \'.KYCCCCYK.\',\n    \'KYCWCCWCYK\',\n    \'KYCWWWWCYK\',\n    \'KYCWCCWCYK\',\n    \'.KYCCCCYK.\',\n    \'..KYYYYK..\',\n    \'...KKKK...\',\n  ],\n  palette: {\n    K: ZX_PALETTE.black,\n    Y: ZX_PALETTE.brightYellow,\n    C: ZX_PALETTE.brightCyan,\n    W: ZX_PALETTE.brightWhite,\n  },\n};\n\n// Backwards-compatible aliases used by title / legacy references\nexport const SPRITE_HERO_MICRODENT = SPRITE_ZUBOK_A;\nexport const SPRITE_HERO_TEATRO = SPRITE_SIGNALIK_A;\n\nexport const SPRITE_CARIES_TARGET: PixelSprite = {\n  rows: [\n    \'..WWWWWW..\',\n    \'.WWMMMMWW.\',\n    \'WWMMRRMMWW\',\n    \'WWMRRRMMWW\',\n    \'WWMMMMMMWW\',\n    \'.WWWWWWWW.\',\n    \'.WW..WWWW.\',\n    \'.WW...WW..\',\n    \'..W...W...\',\n  ],\n  palette: {\n    W: ZX_PALETTE.white,\n    M: ZX_PALETTE.magenta,\n    R: ZX_PALETTE.brightRed,\n  },\n};\n\nexport const SPRITE_TOOTH_RESTORED: PixelSprite = {\n  rows: [\n    \'..CCCCCC..\',\n    \'.CWWWWWWC.\',\n    \'CWWCWWWWWC\',\n    \'CWWWWWWWWC\',\n    \'CWWWWWWWWC\',\n    \'.WWWWWWWW.\',\n    \'.WWW..WWW.\',\n    \'.WW....WW.\',\n    \'..C....C..\',\n  ],\n  palette: {\n    W: ZX_PALETTE.brightWhite,\n    C: ZX_PALETTE.brightCyan,\n  },\n};\n\nexport const SPRITE_FIBER_UNLINKED: PixelSprite = {\n  rows: [\n    \'...RRRR...\',\n    \'..R....R..\',\n    \'.R.YYYY.R.\',\n    \'R..Y..Y..R\',\n    \'R..Y..Y..R\',\n    \'.R.YYYY.R.\',\n    \'..R....R..\',\n    \'...RRRR...\',\n  ],\n  palette: {\n    R: ZX_PALETTE.brightRed,\n    Y: ZX_PALETTE.yellow,\n  },\n};\n\nexport const SPRITE_FIBER_LINKED: PixelSprite = {\n  rows: [\n    \'...CCCC...\',\n    \'..CWWWWC..\',\n    \'.CWGGGGWC.\',\n    \'CWGGWWGGWC\',\n    \'CWGGWWGGWC\',\n    \'.CWGGGGWC.\',\n    \'..CWWWWC..\',\n    \'...CCCC...\',\n  ],\n  palette: {\n    C: ZX_PALETTE.brightCyan,\n    W: ZX_PALETTE.brightWhite,\n    G: ZX_PALETTE.brightGreen,\n  },\n};\n\nexport const SPRITE_ORNAMENT_UNLIT: PixelSprite = {\n  rows: [\n    \'...YYYY...\',\n    \'....YY....\',\n    \'..RRRRRR..\',\n    \'.RR....RR.\',\n    \'.R..RR..R.\',\n    \'.RR....RR.\',\n    \'..RRRRRR..\',\n    \'...RRRR...\',\n  ],\n  palette: {\n    Y: ZX_PALETTE.yellow,\n    R: ZX_PALETTE.red,\n  },\n};\n\nexport const SPRITE_ORNAMENT_LIT: PixelSprite = {\n  rows: [\n    \'...YYYY...\',\n    \'....WW....\',\n    \'..GGGGGG..\',\n    \'.GGYYYYGG.\',\n    \'.GYWWWWYG.\',\n    \'.GGYYYYGG.\',\n    \'..GGGGGG..\',\n    \'...CCCC...\',\n  ],\n  palette: {\n    Y: ZX_PALETTE.brightYellow,\n    W: ZX_PALETTE.brightWhite,\n    G: ZX_PALETTE.brightGreen,\n    C: ZX_PALETTE.brightCyan,\n  },\n};\n\nexport const SPRITE_CROWN_PICKUP: PixelSprite = {\n  rows: [\n    \'Y...YY...Y\',\n    \'YY.YYYY.YY\',\n    \'YYYYYYYYYY\',\n    \'YWWYWWYWWY\',\n    \'YYYYYYYYYY\',\n    \'.YYYYYYYY.\',\n  ],\n  palette: {\n    Y: ZX_PALETTE.brightYellow,\n    W: ZX_PALETTE.brightWhite,\n  },\n};\n\nexport const SPRITE_COIL_PICKUP: PixelSprite = {\n  rows: [\n    \'..CCCCCC..\',\n    \'.CWW..WWC.\',\n    \'CW.CCCC.WC\',\n    \'CW.CYYC.WC\',\n    \'.CWW..WWC.\',\n    \'..CCCCCC..\',\n  ],\n  palette: {\n    C: ZX_PALETTE.brightCyan,\n    W: ZX_PALETTE.brightWhite,\n    Y: ZX_PALETTE.brightYellow,\n  },\n};\n\nexport const SPRITE_GIFT_PICKUP: PixelSprite = {\n  rows: [\n    \'..YY..YY..\',\n    \'.RRRRRRRR.\',\n    \'.RRRYRRRR.\',\n    \'.YYYYYYYY.\',\n    \'.RRRYRRRR.\',\n    \'.RRRRRRRR.\',\n  ],\n  palette: {\n    R: ZX_PALETTE.brightRed,\n    Y: ZX_PALETTE.brightYellow,\n  },\n};\n\n// Enemy 1: Patroller (Plaque Gremlin / Static Gremlin)\nexport const SPRITE_ENEMY_PATROLLER: PixelSprite = {\n  rows: [\n    \'..GGGGGG..\',\n    \'.GGGGGGGG.\',\n    \'GGWWGGWWGG\',\n    \'GGWBGGWBGG\',\n    \'GGGGGGGGGG\',\n    \'G.GGGGGG.G\',\n    \'G.G.GG.G.G\',\n    \'..G....G..\',\n  ],\n  palette: {\n    G: ZX_PALETTE.brightGreen,\n    W: ZX_PALETTE.brightWhite,\n    B: ZX_PALETTE.brightRed,\n  },\n};\n\n// Enemy 2: Kiter / Ranged (Sugar Imp / Lag Drone)\nexport const SPRITE_ENEMY_KITER: PixelSprite = {\n  rows: [\n    \'.M......M.\',\n    \'..MMMMMM..\',\n    \'.MMWWWWMM.\',\n    \'MMWRMMRWMM\',\n    \'MMMMMMMMMM\',\n    \'.MMYYYYMM.\',\n    \'..M.MM.M..\',\n    \'.M......M.\',\n  ],\n  palette: {\n    M: ZX_PALETTE.brightMagenta,\n    W: ZX_PALETTE.brightWhite,\n    R: ZX_PALETTE.brightRed,\n    Y: ZX_PALETTE.brightYellow,\n  },\n};\n\n// Enemy 3: Charger (Tartar Tank / Packet Crusher)\nexport const SPRITE_ENEMY_CHARGER: PixelSprite = {\n  rows: [\n    \'.RRRRRRRR.\',\n    \'RRYYYYYYRR\',\n    \'RYWWRRWWYR\',\n    \'RYBBRRBBYR\',\n    \'RRRRRRRRRR\',\n    \'RYYYYYYYYR\',\n    \'RR.RRRR.RR\',\n    \'R........R\',\n  ],\n  palette: {\n    R: ZX_PALETTE.brightRed,\n    Y: ZX_PALETTE.brightYellow,\n    W: ZX_PALETTE.brightWhite,\n    B: ZX_PALETTE.black,\n  },\n};\n\nexport const SPRITE_XMAS_TREE: PixelSprite = {\n  rows: [\n    \'....YY....\',\n    \'....YY....\',\n    \'...GGGG...\',\n    \'..GGYGGG..\',\n    \'..GGGGGG..\',\n    \'.GGRGGGGG.\',\n    \'.GGGGGGCG.\',\n    \'GGGGYGGGGG\',\n    \'GGRGGGGGRG\',\n    \'....MM....\',\n    \'...MMMM...\',\n  ],\n  palette: {\n    Y: ZX_PALETTE.brightYellow,\n    G: ZX_PALETTE.brightGreen,\n    R: ZX_PALETTE.brightRed,\n    C: ZX_PALETTE.brightCyan,\n    M: ZX_PALETTE.red,\n  },\n};\n\n/**\n * STAGE 6 FINALE BOSS: VE\304\275K\303\235 RU\305\240I\304\214 (20x18 pixel art in strict ZX_PALETTE)\n */\nexport const SPRITE_BOSS_RUSIC: PixelSprite = {\n  rows: [\n    \'....RR........RR....\',\n    \'....RYY......YYR....\',\n    \'.....RMMRRRRMMR.....\',\n    \'...MMMMMMMMMMMMMM...\',\n    \'..MMRRRRRRRRRRRRMM..\',\n    \'.MMRRWWWWMMWWWWRRMM.\',\n    \'.MRRWWKKWMMWKKWWRRM.\',\n    \'MMRRWWKKWMMWKKWWRRMM\',\n    \'MMRRRRRRRRRRRRRRRRMM\',\n    \'MMRRYMMMMMMMMMMYRRM.\',\n    \'MMRRYYYYYYYYYYYYRRMM\',\n    \'.MRRMYKMYKMYKMYKRRM.\',\n    \'.MMRRRRRRRRRRRRRRMM.\',\n    \'..MMMMMMMMMMMMMMMM..\',\n    \'...MM.MM....MM.MM...\',\n    \'..RR..RR....RR..RR..\',\n    \'..RR..RR....RR..RR..\',\n    \'.RRR..RR....RR..RRR.\',\n  ],\n  palette: {\n    R: ZX_PALETTE.brightRed,\n    M: ZX_PALETTE.brightMagenta,\n    Y: ZX_PALETTE.brightYellow,\n    W: ZX_PALETTE.brightWhite,\n    K: ZX_PALETTE.black,\n  },\n};\n\n/**\n * Friendly Rimavsk\303\241 Sobota citizen NPC sprite (Dizzy/Towdie homage, strict ZX_PALETTE).\n */\nexport const SPRITE_CITIZEN: PixelSprite = {\n  rows: [\n    \'...YYYY...\',\n    \'..YWWWWY..\',\n    \'..WKWWKW..\',\n    \'..WWWWWW..\',\n    \'...RRRR...\',\n    \'..GGRRGG..\',\n    \'.GGGRRGGG.\',\n    \'..GGGGGG..\',\n    \'..BB..BB..\',\n    \'..KK..KK..\',\n  ],\n  palette: {\n    Y: ZX_PALETTE.brightYellow,\n    W: ZX_PALETTE.brightWhite,\n    K: ZX_PALETTE.black,\n    R: ZX_PALETTE.brightRed,\n    G: ZX_PALETTE.brightGreen,\n    B: ZX_PALETTE.blue,\n  },\n};\n\n/**\n * Draws a crisp 1:1 pixel-aligned sprite onto the 256x192 Didaktik M logical canvas.\n */\nexport function drawPixelSprite(\n  ctx: CanvasRenderingContext2D,\n  sprite: PixelSprite,\n  cx: number,\n  cy: number,\n  options?: {\n    overrideColor?: string;\n    scaleX?: number;\n    scaleY?: number;\n    flipX?: boolean;\n    alpha?: number;\n  }\n): void {\n  const rows = sprite.rows;\n  const h = rows.length;\n  const w = rows[0].length;\n  const sx = options?.scaleX ?? 1;\n  const sy = options?.scaleY ?? 1;\n  const flipX = options?.flipX ?? false;\n  const prevAlpha = ctx.globalAlpha;\n\n  if (options?.alpha !== undefined) {\n    ctx.globalAlpha = options.alpha;\n  }\n\n  ctx.save();\n  ctx.translate(Math.round(cx), Math.round(cy));\n  ctx.scale(flipX ? -sx : sx, sy);\n\n  const ox = -Math.floor(w / 2);\n  const oy = -Math.floor(h / 2);\n\n  for (let y = 0; y < h; y++) {\n    const row = rows[y];\n    for (let x = 0; x < w; x++) {\n      const ch = row[x];\n      if (ch === \'.\') continue;\n      const color = options?.overrideColor ?? sprite.palette[ch];\n      if (!color) continue;\n      ctx.fillStyle = color;\n      ctx.fillRect(ox + x, oy + y, 1, 1);\n    }\n  }\n\n  ctx.restore();\n  ctx.globalAlpha = prevAlpha;\n}\n"
