      name: "run_command"
      arguments_json: "{\"CommandLine\":\"trap \'playwright-cli close\' EXIT\\nplaywright-cli open --browser=chromium \\\"http://localhost:3000/\\\" && \\\\\\nplaywright-cli resize 1440 900 && \\\\\\nplaywright-cli run-code \'async (page) => {\\n  // Skip intro -> Title screen\\n  await page.waitForTimeout(250);\\n  await page.keyboard.press(\\\"Space\\\");\\n  await page.waitForTimeout(200);\\n\\n  // Open Visual Manual (V) -> Ch. 02 (Fyzick\303\241 ed\303\255cia: SVG Box + ZADN\303\201) & Ch. 06 (63x88mm cards)\\n  await page.keyboard.press(\\\"KeyV\\\");\\n  await page.waitForTimeout(250);\\n  await page.getByRole(\\\"tab\\\", { name: /Fyzick\303\241 ed\303\255cia/i }).click();\\n  await page.waitForTimeout(150);\\n  const hasSvgBtn = await page.getByRole(\\\"button\\\", { name: /krabi\304\215ku \\\\.SVG/i }).isVisible();\\n  if (!hasSvgBtn) throw new Error(\\\"Missing 3D box SVG button!\\\");\\n  const hasFixedZadna = await page.getByText(\\\"J-CARD \302\267 ZADN\303\201 STRANA KAZETY\\\").isVisible();\\n  if (!hasFixedZadna) throw new Error(\\\"Missing fixed ZADN\303\201 diacritic!\\\");\\n  await page.screenshot({ path: \\\".playwright-cli/v3-r2h-manual-ch2.png\\\", timeout: 15000 });\\n\\n  await page.getByRole(\\\"tab\\\", { name: /Zberate\304\276sk\303\241 karta/i }).click();\\n  await page.waitForTimeout(150);\\n  // Extract exact 8-char secret code from Chapter 06 card\\n  const codeText = (await page.locator(\\\"text=/^[A-Z0-9]{8}$/\\\").first().textContent())?.trim() || \\\"\\\";\\n  if (codeText.length !== 8) throw new Error(\\\"Could not read 8-char secret code from Ch. 06 card: \\\" + codeText);\\n  await page.screenshot({ path: \\\".playwright-cli/v3-r2h-manual-ch6.png\\\", timeout: 15000 });\\n\\n  // Close Manual -> press K for Secret Room 1270 -> test invalid code -> test valid code unlock!\\n  await page.keyboard.press(\\\"Escape\\\");\\n  await page.waitForTimeout(150);\\n  await page.keyboard.press(\\\"KeyK\\\");\\n  await page.waitForTimeout(200);\\n  const input = page.locator(\\\"input\\\").first();\\n  await input.fill(\\\"WRONG123\\\");\\n  await page.getByRole(\\\"button\\\", { name: /Odomkn\303\272\305\245/i }).click();\\n  await page.waitForTimeout(150);\\n  const errVisible = await page.getByText(/Nespr\303\241vny|Neplatn\303\275/i).isVisible();\\n  if (!errVisible) throw new Error(\\\"Invalid code did not show error!\\\");\\n\\n  await input.fill(codeText);\\n  await page.getByRole(\\\"button\\\", { name: /Odomkn\303\272\305\245/i }).click();\\n  await page.waitForTimeout(200);\\n  await page.screenshot({ path: \\\".playwright-cli/v3-r2h-secret-unlocked.png\\\", timeout: 15000 });\\n  return \\\"VERIFIED_MANUAL_AND_SECRET_ROOM:\\\" + codeText;\\n}\' && \\\\\\nplaywright-cli console\", \"Cwd\":\"/app/applet\", \"WaitMsBeforeAsync\":10000, \"toolAction\":\"Verifying Visual Manual Ch. 02/06 and Secret Room 1270 unlock flow\", \"toolSummary\":\"Verify Manual & Secret Room 1270\"}"
