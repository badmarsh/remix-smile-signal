  view_file {
    absolute_path_uri: "file:///src/components/VisualManualModal.tsx"
    end_line: 970
    content: "import React, { useRef, useState } from \'react\';\nimport { CITIZEN_SIGNATURES, deriveSecretCode } from \'../data/signatures\';\nimport { DIDAKTIK_SPECS, LOAD_STEPS, MG_DIN_PINOUT } from \'../didaktik/specs\';\nimport { SPRITE_MVP_PLAQUE, SPRITE_SIGNALIK_A, SPRITE_ZUBOK_A } from \'../game/sprites\';\nimport {\n  DEFAULT_RADO_PORTRAIT_URL,\n  MicrodentLogo,\n  MVP_PLAQUE_IMAGE_URL,\n  PHYSICAL_EDITION_IMAGE_URL,\n  PixelSpriteIcon,\n  RadoPortraitFrame,\n  RimavskaSobotaCrest,\n  TeatroLogo,\n} from \'./BrandEmblems\';\n\ntype ManualChapter = \'venovanie\' | \'fyzicka\' | \'misia\' | \'identita\' | \'plaketa\' | \'karta\';\n\ninterface VisualManualModalProps {\n  open: boolean;\n  radoPhotoUrl: string;\n  isCustomPhoto: boolean;\n  onUploadRadoPhoto: (dataUrl: string) => void;\n  onResetRadoPhoto: () => void;\n  onOpenTapeKit: () => void;\n  onStartGame: () => void;\n  onClose: () => void;\n}\n\nconst CHAPTERS: { id: ManualChapter; num: string; label: string }[] = [\n  { id: \'venovanie\', num: \'01\', label: \'Venovanie\' },\n  { id: \'fyzicka\', num: \'02\', label: \'Fyzick\303\241 ed\303\255cia\' },\n  { id: \'misia\', num: \'03\', label: \'Misia MVP\' },\n  { id: \'identita\', num: \'04\', label: \'Erb & Hardv\303\251r\' },\n  { id: \'plaketa\', num: \'05\', label: \'Plaketa 1. miesto\' },\n  { id: \'karta\', num: \'06\', label: \'Zberate\304\276sk\303\241 karta\' },\n];\n\nconst SECRET_CODE = deriveSecretCode();\n\nexport const VisualManualModal: React.FC<VisualManualModalProps> = ({\n  open,\n  radoPhotoUrl,\n  isCustomPhoto,\n  onUploadRadoPhoto,\n  onResetRadoPhoto,\n  onOpenTapeKit,\n  onStartGame,\n  onClose,\n}) => {\n  const [chapter, setChapter] = useState<ManualChapter>(\'venovanie\');\n  const [photoNote, setPhotoNote] = useState<string | null>(null);\n  const fileInputRef = useRef<HTMLInputElement | null>(null);\n\n  if (!open) return null;\n\n  const handleFileChange = (e: React.ChangeEvent<HTMLInputElement>) => {\n    const file = e.target.files?.[0];\n    if (!file) return;\n    const reader = new FileReader();\n    reader.onload = () => {\n      if (typeof reader.result === \'string\') {\n        onUploadRadoPhoto(reader.result);\n        setPhotoNote(\'Fotka Rada bola aktualizovan\303\241 v hre, v manu\303\241li aj na plakete.\');\n      }\n    };\n    reader.readAsDataURL(file);\n    e.target.value = \'\';\n  };\n\n  const handlePrint = () => {\n    window.print();\n  };\n\n  return (\n    <div\n      className=\"manual-modal-root fixed inset-0 z-50 flex items-center justify-center bg-[#05070c] p-2 sm:p-5\"\n      role=\"dialog\"\n      aria-modal=\"true\"\n      aria-labelledby=\"visual-manual-title\"\n    >\n      <div className=\"manual-sheet relative flex max-h-[94vh] w-full max-w-6xl flex-col overflow-hidden rounded-sm border border-[#3a4254] bg-[#0a0d14] text-[#e8ecf2] shadow-[0_24px_80px_rgba(0,0,0,0.92)]\">\n        {/* Top Techno-Futurism Header Bar */}\n        <header className=\"no-print flex flex-wrap items-center justify-between gap-4 border-b border-[#232938] bg-[#0f1420] px-5 py-3.5\">\n          <div className=\"flex items-center gap-3\">\n            <RimavskaSobotaCrest size={30} />\n            <div>\n              <h2\n                id=\"visual-manual-title\"\n                className=\"font-display text-lg font-bold tracking-wide text-white sm:text-xl\"\n              >\n                Z\303\272bok a sign\303\241lik \302\267 Vizu\303\241lny manu\303\241l\n              </h2>\n              <p className=\"font-mono text-[11px] text-[#9aa5b8]\">\n                Techno-futuristick\303\241 ed\303\255cia \302\267 Venovan\303\251 Radovi Cegl\303\251dymu \302\267 Rimavsk\303\241 Sobota\n              </p>\n            </div>\n          </div>\n\n          <div className=\"flex flex-wrap items-center gap-2\">\n            <input\n              ref={fileInputRef}\n              type=\"file\"\n              accept=\"image/*\"\n              onChange={handleFileChange}\n              className=\"hidden\"\n              aria-label=\"Nahra\305\245 vlastn\303\272 fotografiu Rada Cegl\303\251dyho\"\n            />\n            <button\n              type=\"button\"\n              onClick={() => fileInputRef.current?.click()}\n              className=\"min-h-[38px] cursor-pointer whitespace-nowrap rounded-sm border border-[#3d4659] bg-[#141a28] px-3 py-1.5 font-mono text-xs font-medium text-[#d8e0ec] transition-colors hover:border-[#00e8e8] hover:text-[#00e8e8]\"\n            >\n              Nahra\305\245 fotku Rada\n            </button>\n            {isCustomPhoto && (\n              <button\n                type=\"button\"\n                onClick={() => {\n                  onResetRadoPhoto();\n                  setPhotoNote(\'Obnoven\303\275 predvolen\303\275 techno-futuristick\303\275 portr\303\251t.\');\n                }}\n                className=\"min-h-[38px] cursor-pointer whitespace-nowrap rounded-sm border border-[#3d4659] bg-[#141a28] px-3 py-1.5 font-mono text-xs font-medium text-[#9aa5b8] hover:border-white hover:text-white\"\n              >\n                P\303\264vodn\303\275 portr\303\251t\n              </button>\n            )}\n            <button\n              type=\"button\"\n              onClick={handlePrint}\n              className=\"min-h-[38px] cursor-pointer whitespace-nowrap rounded-sm border border-[#e5b94c] bg-[#1f1c12] px-3.5 py-1.5 font-mono text-xs font-semibold text-[#e5b94c] transition-colors hover:bg-[#e5b94c] hover:text-[#090c12]\"\n            >\n              Tla\304\215i\305\245 / PDF\n            </button>\n            <button\n              type=\"button\"\n              onClick={onClose}\n              aria-label=\"Zavrie\305\245 vizu\303\241lny manu\303\241l\"\n              className=\"min-h-[38px] cursor-pointer whitespace-nowrap rounded-sm border border-[#525b6e] bg-[#141925] px-3.5 py-1.5 font-mono text-xs font-semibold text-white hover:border-[#00e8e8] hover:text-[#00e8e8]\"\n            >\n              Zavrie\305\245\n            </button>\n          </div>\n        </header>\n\n        {/* Chapter Navigation Rail */}\n        <nav\n          className=\"no-print flex items-center gap-1 overflow-x-auto border-b border-[#1f2533] bg-[#0c1019] px-5 py-2\"\n          aria-label=\"Kapitoly vizu\303\241lneho manu\303\241lu\"\n          role=\"tablist\"\n        >\n          {CHAPTERS.map((c) => {\n            const active = chapter === c.id;\n            return (\n              <button\n                key={c.id}\n                type=\"button\"\n                role=\"tab\"\n                aria-selected={active}\n                onClick={() => setChapter(c.id)}\n                className={`min-h-[38px] shrink-0 cursor-pointer whitespace-nowrap rounded-sm px-3.5 py-1.5 font-mono text-xs font-semibold transition-colors ${\n                  active\n                    ? \'bg-[#1c2436] text-[#00e8e8]\'\n                    : \'text-[#8e99ad] hover:text-white\'\n                }`}\n              >\n                <span className=\"mr-1.5 text-[#e5b94c] tabular-nums\">{c.num}.</span>\n                {c.label}\n              </button>\n            );\n          })}\n        </nav>\n\n        {photoNote && (\n          <div className=\"no-print border-b border-[#1f2c24] bg-[#0e1c16] px-5 py-2 font-mono text-xs text-[#3be87a]\" role=\"status\">\n            {photoNote}\n          </div>\n        )}\n\n        {/* Scrollable Editorial Techno-Futurism Canvas */}\n        <div\n          className=\"flex-1 overflow-y-auto p-5 sm:p-8\"\n          style={{\n            backgroundImage:\n              \'linear-gradient(to right, rgba(148,163,184,0.045) 1px, transparent 1px), linear-gradient(to bottom, rgba(148,163,184,0.045) 1px, transparent 1px)\',\n            backgroundSize: \'32px 32px\',\n          }}\n        >\n          {/* CHAPTER 01 \342\200\224 VENOVANIE A MANIFEST REGI\303\223NU */}\n          {chapter === \'venovanie\' && (\n            <section className=\"mx-auto flex max-w-5xl flex-col gap-8\">\n              {/* Hero Architectural Spread */}\n              <div className=\"grid grid-cols-1 items-stretch gap-6 lg:grid-cols-12\">\n                {/* Left 7 cols: Techno-Futurism Editorial Cover & Dedication Prose */}\n                <div className=\"flex flex-col justify-between rounded-sm border border-[#2a3346] bg-[#0e131e]/95 p-6 sm:p-8 lg:col-span-7\">\n                  <div>\n                    <div className=\"flex flex-wrap items-center gap-x-2.5 gap-y-1 font-mono text-xs text-[#9aa5b8]\">\n                      <span className=\"text-[#e5b94c]\">Vydanie 01 \302\267 Rimavsk\303\241 Sobota</span>\n                      <span aria-hidden=\"true\">\302\267</span>\n                      <span>Didaktik M 48K</span>\n                      <span aria-hidden=\"true\">\302\267</span>\n                      <span>Techno-Futurizmus</span>\n                    </div>\n\n                    <h1 className=\"mt-4 text-balance font-display text-4xl font-bold tracking-tight text-white sm:text-5xl\">\n                      Z\303\272bok a sign\303\241lik\n                    </h1>\n                    <p className=\"mt-2 font-mono text-sm font-semibold text-[#00e8e8]\">\n                      Pocta Radovi Cegl\303\251dymu \302\267 1. miesto Celo\305\276ivotn\303\275 MVP v regi\303\263ne\n                    </p>\n\n                    <div className=\"my-5 h-px w-full bg-[#242d3f]\" />\n\n                    <p className=\"max-w-prose text-sm leading-relaxed text-[#cfd7e3] sm:text-base\">\n                      T\303\241to zberate\304\276sk\303\241 retro hra a sprievodn\303\275 vizu\303\241lny manu\303\241l s\303\272 \303\272primn\303\275m{\' \'}\n                      <strong className=\"font-semibold text-white\">\n                        prejavom \303\272cty a v\304\217aky od skupiny ob\304\215anov regi\303\263nu Rimavsk\303\241 Sobota\n                      </strong>\n                      . Je venovan\303\241 <strong className=\"font-semibold text-[#e5b94c]\">Radovi Cegl\303\251dymu</strong> \342\200\224 \304\215loveku, ktor\303\275 sp\303\241ja modern\303\272 medic\303\255nu, optick\303\272 konektivitu, AI inov\303\241cie a odv\303\241\305\276nu v\303\255ziu pre n\303\241\305\241 regi\303\263n.\n                    </p>\n\n                    <p className=\"mt-3.5 max-w-prose text-sm leading-relaxed text-[#b2bccd]\">\n                      Cie\304\276om tvojej misie v hre je prejs\305\245 s dvojicou hrdinov <strong className=\"text-white\">Z\303\272bok</strong> a <strong className=\"text-white\">Sign\303\241lik</strong> naprie\304\215 klinikou{\' \'}\n                      <span className=\"text-white\">microDENT.sk</span> na ulici Istv\303\241na Hatvaniho 2, optickou \303\272stred\305\210ou{\' \'}\n                      <span className=\"text-white\">TeatrO.eu</span>, ponad rieku Rimavu a\305\276 na historick\303\251 Hlavn\303\251 n\303\241mestie Rimavskej Soboty a bezpe\304\215ne dopravi\305\245 Radovi zasl\303\272\305\276en\303\272{\' \'}\n                      <span className=\"text-[#e5b94c]\">plaketu za 1. miesto v kateg\303\263rii Celo\305\276ivotn\303\275 MVP v regi\303\263ne</span>.\n                    </p>\n\n                    {/* Pixel-Art Cast Strip: Z\303\272bok \302\267 Sign\303\241lik \302\267 Plaketa MVP */}\n                    <div className=\"mt-5 grid grid-cols-3 gap-3 border-t border-[#242d3f] pt-4\">\n                      <div className=\"flex items-center gap-2.5\">\n                        <PixelSpriteIcon sprite={SPRITE_ZUBOK_A} size={34} label=\"Z\303\272bok\" />\n                        <div className=\"leading-tight\">\n                          <div className=\"font-mono text-xs font-bold text-white\">Z\303\272bok</div>\n                          <div className=\"font-mono text-[10px] text-[#00e8e8]\">CEREC laser</div>\n                        </div>\n                      </div>\n                      <div className=\"flex items-center gap-2.5\">\n                        <PixelSpriteIcon sprite={SPRITE_SIGNALIK_A} size={34} label=\"Sign\303\241lik\" />\n                        <div className=\"leading-tight\">\n                          <div className=\"font-mono text-xs font-bold text-white\">Sign\303\241lik</div>\n                          <div className=\"font-mono text-[10px] text-[#e5b94c]\">Wi-Fi bublina</div>\n                        </div>\n                      </div>\n                      <div className=\"flex items-center gap-2.5\">\n                        <PixelSpriteIcon sprite={SPRITE_MVP_PLAQUE} size={28} label=\"Plaketa MVP\" />\n                        <div className=\"leading-tight\">\n                          <div className=\"font-mono text-xs font-bold text-[#e5b94c]\">Plaketa #1</div>\n                          <div className=\"font-mono text-[10px] text-[#cfd7e3]\">MVP regi\303\263nu</div>\n                        </div>\n                      </div>\n                    </div>\n                  </div>\n\n                  {/* Institutional Identity Bar inside Cover */}\n                  <div className=\"mt-6 flex flex-wrap items-center justify-between gap-4 border-t border-[#242d3f] pt-5\">\n                    <div className=\"flex flex-wrap items-center gap-5\">\n                      <MicrodentLogo compact />\n                      <TeatroLogo compact />\n                    </div>\n                    <div className=\"flex items-center gap-2.5\">\n                      <RimavskaSobotaCrest size={34} />\n                      <div className=\"font-mono text-[11px] leading-tight text-[#b2bccd]\">\n                        <div className=\"font-semibold text-white\">Rimavsk\303\241 Sobota</div>\n                        <div>Regi\303\263n Gemer-Malohont</div>\n                      </div>\n                    </div>\n                  </div>\n                </div>\n\n                {/* Right 5 cols: Framed Portrait Dossier of Rado Cegl\303\251dy */}\n                <div className=\"flex flex-col justify-between rounded-sm border border-[#3a4254] bg-[#0e131e]/95 p-5 lg:col-span-5\">\n                  <div className=\"relative aspect-square w-full overflow-hidden rounded-sm border border-[#e5b94c]/60 bg-[#090c12]\">\n                    <RadoPortraitFrame\n                      src={radoPhotoUrl || DEFAULT_RADO_PORTRAIT_URL}\n                      sizeClass=\"h-full w-full border-0\"\n                    />\n                    <div className=\"pointer-events-none absolute inset-x-0 bottom-0 bg-gradient-to-t from-[#05080f]/95 via-[#05080f]/60 to-transparent p-4\">\n                      <div className=\"font-mono text-xs font-semibold text-[#e5b94c]\">\n                        Laure\303\241t ocenenia \302\267 1. miesto\n                      </div>\n                      <div className=\"font-display text-2xl font-bold text-white\">\n                        Rado Cegl\303\251dy\n                      </div>\n                      <div className=\"mt-0.5 font-mono text-[11px] text-[#cfd7e3]\">\n                        Celo\305\276ivotn\303\275 MVP v regi\303\263ne \302\267 Rimavsk\303\241 Sobota\n                      </div>\n                    </div>\n                  </div>\n\n                  {/* Dossier Attributes (Zero-Pill clean definition list) */}\n                  <dl className=\"mt-4 divide-y divide-[#1f2636] font-mono text-xs\">\n                    <div className=\"flex items-center justify-between py-2\">\n                      <dt className=\"text-[#8e99ad]\">Kateg\303\263ria ocenenia</dt>\n                      <dd className=\"font-semibold text-[#e5b94c]\">Celo\305\276ivotn\303\275 MVP</dd>\n                    </div>\n                    <div className=\"flex items-center justify-between py-2\">\n                      <dt className=\"text-[#8e99ad]\">Pilier zdravia &amp; optiky</dt>\n                      <dd className=\"text-white\">microDENT.sk \302\267 TeatrO.eu</dd>\n                    </div>\n                    <div className=\"flex items-center justify-between py-2\">\n                      <dt className=\"text-[#8e99ad]\">V\303\255zia regi\303\263nu</dt>\n                      <dd className=\"text-[#00e8e8]\">AI inov\303\241cie \302\267 Free Wi-Fi \302\267 RTX 3090</dd>\n                    </div>\n                  </dl>\n                </div>\n              </div>\n\n              {/* Action Strip */}\n              <div className=\"no-print flex flex-wrap items-center justify-between gap-4 border-t border-[#232938] pt-5\">\n                <p className=\"font-mono text-xs text-[#9aa5b8]\">\n                  Kompletn\303\241 ed\303\255cia be\305\276\303\255 v modernom prehliada\304\215i aj na origin\303\241lnej kazete Didaktik M (Skalica 1990).\n                </p>\n                <div className=\"flex flex-wrap items-center gap-2.5\">\n                  <button\n                    type=\"button\"\n                    onClick={() => setChapter(\'fyzicka\')}\n                    className=\"min-h-[40px] cursor-pointer whitespace-nowrap rounded-sm border border-[#3d4659] bg-[#141a28] px-4 py-2 font-mono text-xs font-semibold text-white hover:border-[#00e8e8] hover:text-[#00e8e8]\"\n                  >\n                    Pozrie\305\245 fyzick\303\272 krabi\304\215ku \342\206\222\n                  </button>\n                  <button\n                    type=\"button\"\n                    onClick={() => {\n                      onClose();\n                      onStartGame();\n                    }}\n                    className=\"min-h-[40px] cursor-pointer whitespace-nowrap rounded-sm border border-[#00e8e8] bg-[#00c8c8] px-5 py-2 font-display text-sm font-bold text-[#070a10] hover:bg-[#00e8e8]\"\n                  >\n                    Spusti\305\245 misiu MVP\n                  </button>\n                </div>\n              </div>\n            </section>\n          )}\n\n          {/* CHAPTER 02 \342\200\224 FYZICK\303\201 ZBERATE\304\275SK\303\201 ED\303\215CIA & TLA\304\214ITE\304\275N\303\211 \305\240T\303\215TKY */}\n          {chapter === \'fyzicka\' && (\n            <section className=\"mx-auto flex max-w-5xl flex-col gap-7\">\n              <div className=\"grid grid-cols-1 items-stretch gap-6 lg:grid-cols-12\">\n                {/* Photorealistic Physical Edition Tabletop Showcase */}\n                <div className=\"overflow-hidden rounded-sm border border-[#3a4254] bg-[#0e131e] lg:col-span-6\">\n                  <img\n                    src={PHYSICAL_EDITION_IMAGE_URL}\n                    alt=\"Zberate\304\276sk\303\241 fyzick\303\241 krabi\304\215ka hry Z\303\272bok a sign\303\241lik s magnetickou kazetou a po\304\215\303\255ta\304\215om Didaktik M na drevenom stole\"\n                    referrerPolicy=\"no-referrer\"\n                    className=\"h-full w-full object-cover\"\n                  />\n                </div>\n\n                {/* Physical Edition Spec Breakdown */}\n                <div className=\"flex flex-col justify-between rounded-sm border border-[#2a3346] bg-[#0e131e]/95 p-6 lg:col-span-6\">\n                  <div>\n                    <div className=\"font-mono text-xs text-[#e5b94c]\">\n                      02. Fyzick\303\241 zberate\304\276sk\303\241 sada \302\267 Dar\304\215ekov\303\251 balenie\n                    </div>\n                    <h3 className=\"mt-2 font-display text-2xl font-bold text-white sm:text-3xl\">\n                      Krabica, magnetick\303\241 kazeta a Didaktik M\n                    </h3>\n                    <p className=\"mt-3 text-sm leading-relaxed text-[#c6cfdd]\">\n                      Fyzick\303\241 verzia hry <strong className=\"text-white\">Z\303\272bok a sign\303\241lik</strong> je navrhnut\303\241 ako poctiv\303\241 zberate\304\276sk\303\241 krabi\304\215ka v \305\241t\303\275le techno-futurizmu 90. rokov \342\200\224 s matn\303\275m \304\215iernym obalom, br\303\272sen\303\275m strieborn\303\275m lemom, erbom Rimavskej Soboty a skuto\304\215nou magnetof\303\263novou kazetou, ktor\303\272 mo\305\276no nahra\305\245 priamo cez port <span className=\"font-mono text-[#00e8e8]\">MG</span>.\n                    </p>\n\n                    <dl className=\"mt-5 divide-y divide-[#202737] border-y border-[#202737] font-mono text-xs\">\n                      <div className=\"flex justify-between gap-4 py-2.5\">\n                        <dt className=\"text-[#8e99ad]\">Zberate\304\276sk\303\241 krabica</dt>\n                        <dd className=\"text-right text-white\">165 \303\227 225 \303\227 38 mm \302\267 Matn\303\275 kart\303\263n 350 g</dd>\n                      </div>\n                      <div className=\"flex justify-between gap-4 py-2.5\">\n                        <dt className=\"text-[#8e99ad]\">M\303\251dium</dt>\n                        <dd className=\"text-right text-[#00e8e8]\">C15/C30 kazeta \302\267 44,1 kHz .WAV / .TAP</dd>\n                      </div>\n                      <div className=\"flex justify-between gap-4 py-2.5\">\n                        <dt className=\"text-[#8e99ad]\">Pr\303\255kaz na spustenie</dt>\n                        <dd className=\"text-right text-[#e5b94c]\">LOAD &quot;&quot; \302\267 Auto\305\241tart RIADOK 10</dd>\n                      </div>\n                      <div className=\"flex justify-between gap-4 py-2.5\">\n                        <dt className=\"text-[#8e99ad]\">S\303\272\304\215as\305\245 balenia</dt>\n                        <dd className=\"text-right text-white\">Manu\303\241l + Plaketa 1. miesto + K\303\241bel DIN</dd>\n                      </div>\n                    </dl>\n                  </div>\n\n                  <div className=\"no-print mt-5 flex flex-wrap gap-2.5\">\n                    <button\n                      type=\"button\"\n                      onClick={() => {\n                        onClose();\n                        onOpenTapeKit();\n                      }}\n                      className=\"min-h-[40px] cursor-pointer whitespace-nowrap rounded-sm border border-[#00e8e8] bg-[#10242c] px-4 py-2 font-mono text-xs font-semibold text-[#00e8e8] hover:bg-[#00e8e8] hover:text-[#070a10]\"\n                    >\n                      Vygenerova\305\245 .WAV kazetu\n                    </button>\n                    <button\n                      type=\"button\"\n                      onClick={handlePrint}\n                      className=\"min-h-[40px] cursor-pointer whitespace-nowrap rounded-sm border border-[#e5b94c] bg-[#1e1a10] px-4 py-2 font-mono text-xs font-semibold text-[#e5b94c] hover:bg-[#e5b94c] hover:text-[#070a10]\"\n                    >\n                      Vytla\304\215i\305\245 prebal &amp; \305\241t\303\255tok\n                    </button>\n                  </div>\n                </div>\n              </div>\n\n              {/* Print-Ready Cassette Sticker + J-Card Blueprint */}\n              <div className=\"rounded-sm border border-[#2a3346] bg-[#0e131e]/95 p-6\">\n                <div className=\"flex flex-wrap items-baseline justify-between gap-2 border-b border-[#222a3a] pb-3\">\n                  <h4 className=\"font-display text-lg font-bold text-white\">\n                    Technick\303\275 v\303\275kres: \305\240t\303\255tok na kazetu (102 \303\227 64 mm) &amp; J-Card prebal\n                  </h4>\n                  <span className=\"font-mono text-xs text-[#9aa5b8]\">\n                    Pripraven\303\251 na tla\304\215 pre fyzick\303\275 dar\304\215ek\n                  </span>\n                </div>\n\n                <div className=\"mt-5 grid grid-cols-1 gap-6 lg:grid-cols-12\">\n                  {/* Cassette Shell Label Mockup */}\n                  <div className=\"lg:col-span-7\">\n                    <div className=\"rounded-sm border-2 border-[#465166] bg-[#12161f] p-4\">\n                      <div className=\"rounded-sm border border-[#00e8e8]/50 bg-[#080c14] p-4\">\n                        <div className=\"flex items-center justify-between gap-3 border-b border-[#1f293a] pb-2.5\">\n                          <div className=\"flex items-center gap-2.5\">\n                            <RimavskaSobotaCrest size={28} />\n                            <div>\n                              <div className=\"font-display text-lg font-bold tracking-wide text-white\">\n                                Z\303\232BOK A SIGN\303\201LIK\n                              </div>\n                              <div className=\"font-mono text-[10px] text-[#e5b94c]\">\n                                RADO CEGL\303\211DY \302\267 1. MIESTO CELO\305\275IVOTN\303\235 MVP REGI\303\223NU\n                              </div>\n                            </div>\n                          </div>\n                          <div className=\"text-right font-mono text-[11px] font-bold text-[#00e8e8]\">\n                            <div>STRANA A</div>\n                            <div className=\"text-[#9aa5b8]\">DIDAKTIK M</div>\n                          </div>\n                        </div>\n\n                        {/* Authentic Cassette Tape Window Cutout */}\n                        <div className=\"my-4 flex items-center justify-center gap-8 rounded-sm border border-[#2d3648] bg-[#151a24] py-3\">\n                          <div className=\"h-9 w-9 rounded-full border-4 border-[#94a3b8] bg-[#080b12]\" />\n                          <div className=\"h-6 w-28 rounded-sm border border-[#3c4557] bg-[#090c12]\" />\n                          <div className=\"h-9 w-9 rounded-full border-4 border-[#94a3b8] bg-[#080b12]\" />\n                        </div>\n\n                        <div className=\"flex flex-wrap items-center justify-between gap-2 font-mono text-[10px] text-[#b2bccd]\">\n                          <span>microDENT.sk \302\267 TeatrO.eu \302\267 Rimavsk\303\241 Sobota</span>\n                          <span className=\"font-bold text-[#ffee00]\">LOAD &quot;&quot; (ZUBOK&amp;SIG)</span>\n                        </div>\n                      </div>\n                    </div>\n                  </div>\n\n                  {/* J-Card Spine + Tracklist */}\n                  <div className=\"flex flex-col justify-between rounded-sm border border-[#3a4254] bg-[#0a0e17] p-4 font-mono text-xs lg:col-span-5\">\n                    <div>\n                      <div className=\"text-[11px] font-bold text-[#e5b94c]\">\n                        J-CARD \302\267 ZADNA STRANA KAZETY\n                      </div>\n                      <div className=\"mt-2 h-px bg-[#222a3a]\" />\n                      <ul className=\"mt-3 space-y-2 text-[#cfd7e3] tabular-nums\">\n                        <li className=\"flex justify-between\">\n                          <span>01. Pilotn\303\275 t\303\263n &amp; Hlavi\304\215ka</span>\n                          <span className=\"text-[#00e8e8]\">806 Hz</span>\n                        </li>\n                        <li className=\"flex justify-between\">\n                          <span>02. ZUBOK&amp;SIG (BASIC 48K)</span>\n                          <span className=\"text-[#00e8e8]\">RIADOK 10</span>\n                        </li>\n                        <li className=\"flex justify-between\">\n                          <span>03. 6\303\227 UDG Grafika USR a\342\200\223f</span>\n                          <span className=\"text-[#e5b94c]\">48 B</span>\n                        </li>\n                        <li className=\"flex justify-between\">\n                          <span>04. 1-Bit Viano\304\215n\303\241 fanf\303\241ra</span>\n                          <span className=\"text-[#e5b94c]\">Port 0xFE</span>\n                        </li>\n                      </ul>\n                    </div>\n                    <div className=\"mt-4 border-t border-[#222a3a] pt-3 text-[11px] text-[#9aa5b8]\">\n                      Od skupiny ob\304\215anov regi\303\263nu Rimavsk\303\241 Sobota \302\267 S \303\272ctou a v\304\217akou\n                    </div>\n                  </div>\n                </div>\n              </div>\n            </section>\n          )}\n\n          {/* CHAPTER 03 \342\200\224 MISIA: DORU\304\214ENIE PLAKETY MVP */}\n          {chapter === \'misia\' && (\n            <section className=\"mx-auto flex max-w-5xl flex-col gap-7\">\n              {/* Top Mission Split: MVP Plaque Photo + Mission Brief */}\n              <div className=\"grid grid-cols-1 items-stretch gap-6 lg:grid-cols-12\">\n                <div className=\"overflow-hidden rounded-sm border border-[#e5b94c]/60 bg-[#0e131e] lg:col-span-6\">\n                  <img\n                    src={MVP_PLAQUE_IMAGE_URL}\n                    alt=\"Plaketa za 1. miesto v kateg\303\263rii Celo\305\276ivotn\303\275 MVP regi\303\263nu pre Rada Cegl\303\251dyho\"\n                    referrerPolicy=\"no-referrer\"\n                    className=\"h-full w-full object-cover\"\n                  />\n                </div>\n                <div className=\"flex flex-col justify-between rounded-sm border border-[#2a3346] bg-[#0e131e]/95 p-6 lg:col-span-6\">\n                  <div>\n                    <div className=\"font-mono text-xs text-[#00e8e8]\">\n                      03. Opera\304\215n\303\275 br\303\255fing \302\267 6 k\303\264l v 3 dejstv\303\241ch\n                    </div>\n                    <h3 className=\"mt-2 font-display text-2xl font-bold text-white sm:text-3xl\">\n                      Doru\304\215 plaketu 1. miesto Radovi Cegl\303\251dymu\n                    </h3>\n                    <p className=\"mt-3 text-sm leading-relaxed text-[#c6cfdd]\">\n                      Ob\304\215ania regi\303\263nu pripravili pre Rada jedine\304\215n\303\272 pam\303\244tn\303\272 plaketu za prv\303\251 miesto v kateg\303\263rii <strong className=\"text-[#e5b94c]\">Celo\305\276ivotn\303\275 MVP v regi\303\263ne</strong>. Aby sa v\305\241ak dostala a\305\276 na p\303\263dium v Rimavskej Sobote, mus\303\255\305\241 zabezpe\304\215i\305\245 bezchybn\303\272 prev\303\241dzku oboch k\304\276\303\272\304\215ov\303\275ch uzlov \342\200\224 zubnej kliniky aj optickej siete.\n                    </p>\n                  </div>\n\n                  <div className=\"mt-5 grid grid-cols-3 gap-3 border-t border-[#222a3a] pt-4 font-mono\">\n                    <div>\n                      <div className=\"whitespace-nowrap text-[11px] text-[#00e8e8]\">1. dejstvo (1\342\200\2232)</div>\n                      <div className=\"mt-0.5 text-xs font-bold text-white\">microDENT.sk</div>\n                      <div className=\"mt-0.5 text-[11px] text-[#9aa5b8]\">Hatvaniho 2 \302\267 Endo</div>\n                    </div>\n                    <div>\n                      <div className=\"whitespace-nowrap text-[11px] text-[#e5b94c]\">2. dejstvo (3\342\200\2234)</div>\n                      <div className=\"mt-0.5 text-xs font-bold text-white\">TeatrO.eu</div>\n                      <div className=\"mt-0.5 text-[11px] text-[#9aa5b8]\">RSNET \302\267 Rimava</div>\n                    </div>\n                    <div>\n                      <div className=\"whitespace-nowrap text-[11px] text-[#3be87a]\">3. dejstvo (5\342\200\2236)</div>\n                      <div className=\"mt-0.5 text-xs font-bold text-white\">Rimavsk\303\241 Sobota</div>\n                      <div className=\"mt-0.5 text-[11px] text-[#9aa5b8]\">M\303\272zeum \302\267 N\303\241mestie</div>\n                    </div>\n                  </div>\n                </div>\n              </div>\n\n              {/* Retro Canon Inspiration Grid (ZX Spectrum & Czechoslovak Legends) */}\n              <div className=\"rounded-sm border border-[#2a3346] bg-[#0e131e]/95 p-6\">\n                <div className=\"flex flex-wrap items-baseline justify-between gap-2 border-b border-[#222a3a] pb-3\">\n                  <h4 className=\"font-display text-lg font-bold text-white\">\n                    In\305\241pir\303\241cia z k\303\241nonu legiend Didaktik M &amp; \304\215eskoslovenskej sc\303\251ny\n                  </h4>\n                  <span className=\"font-mono text-xs text-[#00e8e8]\">\n                    Ultrasoft \302\267 Fuxoft \302\267 Ultimate \302\267 Melodik AY-3-8912\n                  </span>\n                </div>\n                <div className=\"mt-4 grid grid-cols-1 gap-4 text-xs leading-relaxed text-[#c6cfdd] md:grid-cols-3\">\n                  <div>\n                    <div className=\"font-mono font-bold text-[#00e8e8]\">\n                      Dizzy \302\267 Towdie \302\267 Pedro \302\267 Belegost\n                    </div>\n                    <p className=\"mt-1\">\n                      V ka\305\276dom zo 6 k\303\264l h\304\276ad\303\241\305\241 region\303\241lny artefakt (CEREC 3D korunka, Optick\303\275 patchcord 10G, Kronika Rymos Zumbota 1270, Plaketa MVP), ktor\303\275 dopln\303\255 \305\276ivot a zap\303\255\305\241e sa do kroniky na spodku obrazovky.\n                    </p>\n                  </div>\n                  <div>\n                    <div className=\"font-mono font-bold text-[#e5b94c]\">\n                      Saboteur! \302\267 Bubble Bobble \302\267 Target: Renegade\n                    </div>\n                    <p className=\"mt-1\">\n                      Prep\303\255naj kl\303\241vesom <strong className=\"text-white\">C</strong> medzi Z\303\272bkom a Sign\303\241likom (druh\303\275 hrdina \305\245a sprev\303\241dza a pom\303\241ha \304\215isti\305\245 ciele), uv\303\244z\305\210uj ru\305\241i\304\215ov v Sign\303\241likovej Wi-Fi bubline a vyh\303\275baj sa \303\272tokom ninja \303\272hybom <strong className=\"text-white\">Shift</strong>.\n                    </p>\n                  </div>\n                  <div>\n                    <div className=\"font-mono font-bold text-[#3be87a]\">\n                      F.I.R.E. \302\267 Exolon \302\267 R-Type \302\267 Elite \302\267 Knight Lore \302\267 Atomix \302\267 Boovie\n                    </div>\n                    <p className=\"mt-1\">\n                      Dvojit\303\251 plazmov\303\251 vlny, atomixov\303\251 optick\303\251 v\303\244zby medzi uzlami, kamenn\303\251 klenby m\303\272zea, rotuj\303\272ci vektorov\303\275 maj\303\241k v noci nad Rimavskou Sobotou a prep\303\255nate\304\276n\303\275 zvukov\303\275 modul <strong className=\"text-white\">Didaktik Melodik AY [H]</strong>.\n                    </p>\n                  </div>\n                </div>\n              </div>\n\n              {/* Controls & Tactical Field Guide */}\n              <div className=\"grid grid-cols-1 gap-6 lg:grid-cols-12\">\n                {/* Dual Control Matrix */}\n                <div className=\"rounded-sm border border-[#2a3346] bg-[#0e131e]/95 p-5 lg:col-span-6\">\n                  <h4 className=\"font-display text-lg font-bold text-white\">\n                    Ovl\303\241danie \302\267 Modern\303\251 PC vs. Didaktik M\n                  </h4>\n                  <dl className=\"mt-3 divide-y divide-[#1f2636] font-mono text-xs\">\n                    <div className=\"grid grid-cols-12 py-2\">\n                      <dt className=\"col-span-4 text-[#9aa5b8]\">Pohyb hrdinu</dt>\n                      <dd className=\"col-span-4 text-white\">\305\240\303\255pky / WASD</dd>\n                      <dd className=\"col-span-4 text-[#00e8e8]\">Q A O P / \305\240\303\255pky T</dd>\n                    </div>\n                    <div className=\"grid grid-cols-12 py-2\">\n                      <dt className=\"col-span-4 text-[#9aa5b8]\">Laser / Wi-Fi vlna</dt>\n                      <dd className=\"col-span-4 text-white\">Medzern\303\255k (Space)</dd>\n                      <dd className=\"col-span-4 text-[#00e8e8]\">SPACE / Kempston</dd>\n                    </div>\n                    <div className=\"grid grid-cols-12 py-2\">\n                      <dt className=\"col-span-4 text-[#9aa5b8]\">Duo &amp; Saboteur \303\272hyb</dt>\n                      <dd className=\"col-span-4 text-white\">C (Hrdina) \302\267 Shift (\303\232hyb)</dd>\n                      <dd className=\"col-span-4 text-[#e5b94c]\">Z\303\272bok &lt;-&gt; Sign\303\241lik</dd>\n                    </div>\n                    <div className=\"grid grid-cols-12 py-2\">\n                      <dt className=\"col-span-4 text-[#9aa5b8]\">Zvuk &amp; Melodik AY</dt>\n                      <dd className=\"col-span-4 text-white\">H (Melodik/Beeper) \302\267 M</dd>\n                      <dd className=\"col-span-4 text-[#3be87a]\">Port 0xFE / AY-3-8912</dd>\n                    </div>\n                    <div className=\"grid grid-cols-12 py-2\">\n                      <dt className=\"col-span-4 text-[#9aa5b8]\">Manu\303\241l / Kazeta</dt>\n                      <dd className=\"col-span-4 text-white\">V (Manu\303\241l) \302\267 T (Kazeta)</dd>\n                      <dd className=\"col-span-4 text-[#e5b94c]\">LOAD &quot;&quot; (Port MG)</dd>\n                    </div>\n                  </dl>\n                </div>\n\n                {/* Enemy & Scoring Dossier */}\n                <div className=\"rounded-sm border border-[#2a3346] bg-[#0e131e]/95 p-5 lg:col-span-6\">\n                  <h4 className=\"font-display text-lg font-bold text-white\">\n                    Prek\303\241\305\276ky na trase a bodovanie\n                  </h4>\n                  <ul className=\"mt-3 space-y-2.5 text-xs leading-relaxed text-[#c6cfdd]\">\n                    <li>\n                      <span className=\"font-mono font-bold text-[#3be87a]\">Plakov\303\275 z\303\272bok (Hliadka):</span>{\' \'}\n                      Str\303\241\305\276i chodby kliniky. Zne\305\241kodni ho Z\303\272bkov\303\275m laserom (+150) alebo uv\303\244zni Sign\303\241likovou bublinou a praskni (+250).\n                    </li>\n                    <li>\n                      <span className=\"font-mono font-bold text-[#ff55ff]\">\305\240umov\303\275 ru\305\241i\304\215 (Strelec):</span>{\' \'}\n                      Udr\305\276iava si odstup a pred v\303\275strelom zablik\303\241 v\303\275stra\305\276n\303\275m prstencom \342\200\224 presko\304\215 ho \303\272hybom Shift.\n                    </li>\n                    <li>\n                      <span className=\"font-mono font-bold text-[#ff4040]\">Zubn\303\275 kame\305\210 (\303\232to\304\215n\303\255k):</span>{\' \'}\n                      Pred r\303\275chlym v\303\275padom vyzna\304\215\303\255 smer \304\215iarou \342\200\224 uhni do boku a zasiahni ho (+250 bodov).\n                    </li>\n                    <li>\n                      <span className=\"font-mono font-bold text-[#e5b94c]\">Artefakty Rimavskej Soboty:</span>{\' \'}\n                      CEREC 3D korunka, Zubn\303\275 laser, Optick\303\275 patchcord 10G, Free Wi-Fi + RTX 3090, Kronika 1270 a Plaketa MVP (+400 a\305\276 +1000 b. a +1 \305\276ivot).\n                    </li>\n                  </ul>\n                </div>\n              </div>\n            </section>\n          )}\n\n          {/* CHAPTER 04 \342\200\224 IDENTITA, ERB A HARDV\303\211R DIDAKTIK M */}\n          {chapter === \'identita\' && (\n            <section className=\"mx-auto flex max-w-5xl flex-col gap-7\">\n              {/* Institutional & Brand Showcase Grid */}\n              <div className=\"grid grid-cols-1 gap-4 md:grid-cols-3\">\n                <div className=\"flex flex-col justify-between rounded-sm border border-[#2a3346] bg-[#0e131e]/95 p-5\">\n                  <div className=\"flex items-center gap-3.5\">\n                    <RimavskaSobotaCrest size={54} />\n                    <div>\n                      <div className=\"font-display text-base font-bold text-white\">\n                        Rimavsk\303\241 Sobota\n                      </div>\n                      <div className=\"font-mono text-[11px] text-[#e5b94c]\">\n                        Rymos Zumbota \302\267 1270\n                      </div>\n                    </div>\n                  </div>\n                  <p className=\"mt-3 text-xs leading-relaxed text-[#b2bccd]\">\n                    Heraldick\303\275 blaz\303\263n: <em>\342\200\236V striebornom \305\241t\303\255te \304\215ierny orol v \304\215ervenej zbroji.\342\200\234</em> Mesto na rieke Rimava s pamiatkov\303\275m Hlavn\303\275m n\303\241mest\303\255m, Kostolom sv. J\303\241na Krstite\304\276a, Gemersko-malohontsk\303\275m m\303\272zeom v hus\303\241rskych kas\303\241r\305\210ach a letn\303\275m strediskom Kurinec \342\200\223 Zelen\303\241 voda.\n                  </p>\n                </div>\n\n                <div className=\"flex flex-col justify-between rounded-sm border border-[#2a3346] bg-[#0e131e]/95 p-5\">\n                  <MicrodentLogo />\n                  <p className=\"mt-3 text-xs leading-relaxed text-[#b2bccd]\">\n                    Modern\303\241 bezbolestn\303\241 zubn\303\241 klinika na ulici <strong className=\"text-white\">Istv\303\241na Hatvaniho 2</strong> v Rimavskej Sobote \342\200\224 \305\241pi\304\215kov\303\251 zubn\303\251 mikroskopy, 3D r\303\266ntgen CBCT, korunky na po\304\215kanie <strong className=\"text-[#00e8e8]\">CEREC</strong>, zubn\303\275 laser, mikroskopick\303\241 endodoncia a implantol\303\263gia.\n                  </p>\n                </div>\n\n                <div className=\"flex flex-col justify-between rounded-sm border border-[#2a3346] bg-[#0e131e]/95 p-5\">\n                  <TeatroLogo />\n                  <p className=\"mt-3 text-xs leading-relaxed text-[#b2bccd]\">\n                    Region\303\241lna telekomunika\304\215n\303\241 zna\304\215ka optick\303\251ho a bezdr\303\264tov\303\251ho internetu a digit\303\241lnej <strong className=\"text-[#e5b94c]\">IPTV telev\303\255zie</strong> s TV arch\303\255vom a nahr\303\241van\303\255m (RSNET Rimavsk\303\241 Sobota), spojen\303\241 s technologickou a medi\303\241lnou stopou Rada Cegl\303\251dyho v regi\303\263ne.\n                  </p>\n                </div>\n              </div>\n\n              {/* Didaktik M Authentic Hardware & DIN MG Wiring */}\n              <div className=\"grid grid-cols-1 gap-6 rounded-sm border border-[#2a3346] bg-[#0e131e]/95 p-6 lg:grid-cols-12\">\n                <div className=\"lg:col-span-5\">\n                  <div className=\"overflow-hidden rounded-sm border border-[#3a4254] bg-[#090c12]\">\n                    <img\n                      src=\"./assets/aistudio/image_3bf278e7.png\"\n                      alt=\"Origin\303\241lny \304\215eskoslovensk\303\275 po\304\215\303\255ta\304\215 Didaktik M\"\n                      referrerPolicy=\"no-referrer\"\n                      className=\"h-auto w-full object-cover\"\n                    />\n                  </div>\n                  <p className=\"mt-2 font-mono text-[11px] text-[#9aa5b8]\">\n                    Didaktik M (V\303\275robn\303\251 dru\305\276stvo Didaktik Skalica, 1990\342\200\2231993)\n                  </p>\n\n                  <div className=\"mt-4 border-t border-[#222a3a] pt-4\">\n                    <h4 className=\"font-mono text-xs font-bold text-white\">\n                      Zapojenie 5-pin DIN (MG)\n                    </h4>\n                    <ul className=\"mt-2 space-y-1 font-mono text-[11px] text-[#b2bccd]\">\n                      {MG_DIN_PINOUT.map((p) => (\n                        <li key={p.pin}>\n                          <span className=\"font-bold text-[#00e8e8]\">Pin {p.pin}:</span> {p.signal}\n                        </li>\n                      ))}\n                    </ul>\n                  </div>\n                </div>\n\n                <div className=\"flex flex-col justify-between lg:col-span-7\">\n                  <div>\n                    <h3 className=\"font-display text-xl font-bold text-white\">\n                      Technick\303\241 \305\241pecifik\303\241cia Didaktik M &amp; postup nahrania\n                    </h3>\n                    <dl className=\"mt-3 divide-y divide-[#1f2636] border-y border-[#1f2636]\">\n                      {DIDAKTIK_SPECS.map((spec) => (\n                        <div key={spec.label} className=\"grid grid-cols-12 gap-2 py-2 text-xs\">\n                          <dt className=\"col-span-3 font-mono font-semibold text-[#00e8e8]\">\n                            {spec.label}\n                          </dt>\n                          <dd className=\"col-span-9\">\n                            <div className=\"font-mono font-semibold text-white\">{spec.value}</div>\n                            <div className=\"text-[#9aa5b8]\">{spec.detail}</div>\n                          </dd>\n                        </div>\n                      ))}\n                    </dl>\n\n                    <ol className=\"mt-4 space-y-2\">\n                      {LOAD_STEPS.map((s) => (\n                        <li key={s.step} className=\"text-xs leading-relaxed text-[#b2bccd]\">\n                          <span className=\"font-mono font-bold text-[#e5b94c]\">{s.step}. </span>\n                          <span className=\"font-semibold text-white\">{s.title}: </span>\n                          {s.text}\n                        </li>\n                      ))}\n                    </ol>\n                  </div>\n\n                  <div className=\"no-print mt-5\">\n                    <button\n                      type=\"button\"\n                      onClick={() => {\n                        onClose();\n                        onOpenTapeKit();\n                      }}\n                      className=\"min-h-[40px] cursor-pointer whitespace-nowrap rounded-sm border border-[#00e8e8] bg-[#10242c] px-4 py-2 font-mono text-xs font-semibold text-[#00e8e8] hover:bg-[#00e8e8] hover:text-[#070a10]\"\n                    >\n                      Otvori\305\245 \305\241t\303\272dio kazety, UDG a Chiptune \342\206\222\n                    </button>\n                  </div>\n                </div>\n              </div>\n            </section>\n          )}\n\n          {/* CHAPTER 05 \342\200\224 OFICI\303\201LNA PLAKETA 1. MIESTO (TLA\304\214ITE\304\275N\303\235 CERTIFIK\303\201T) */}\n          {chapter === \'plaketa\' && (\n            <section className=\"mx-auto flex max-w-4xl flex-col gap-6\">\n              <div className=\"relative overflow-hidden rounded-sm border-2 border-[#e5b94c] bg-[#0b0f18] p-7 sm:p-10\">\n                {/* Corner Architectural Precision Brackets */}\n                <div className=\"pointer-events-none absolute top-3 left-3 h-5 w-5 border-t-2 border-l-2 border-[#00e8e8]\" />\n                <div className=\"pointer-events-none absolute top-3 right-3 h-5 w-5 border-t-2 border-r-2 border-[#00e8e8]\" />\n                <div className=\"pointer-events-none absolute bottom-3 left-3 h-5 w-5 border-b-2 border-l-2 border-[#00e8e8]\" />\n                <div className=\"pointer-events-none absolute bottom-3 right-3 h-5 w-5 border-b-2 border-r-2 border-[#00e8e8]\" />\n\n                {/* Top Heraldic Header */}\n                <div className=\"flex flex-wrap items-center justify-between gap-4 border-b border-[#252e42] pb-5\">\n                  <div className=\"flex items-center gap-3.5\">\n                    <RimavskaSobotaCrest size={50} />\n                    <div>\n                      <div className=\"font-mono text-xs font-semibold tracking-wider text-[#e5b94c]\">\n                        PAM\303\204TN\303\201 PLAKETA \302\267 \304\214ESTN\303\211 OCENENIE\n                      </div>\n                      <div className=\"font-mono text-xs text-[#9aa5b8]\">\n                        Regi\303\263n Rimavsk\303\241 Sobota \302\267 Ed\303\255cia Didaktik M\n                      </div>\n                    </div>\n                  </div>\n                  <div className=\"text-right font-display text-4xl font-bold text-[#e5b94c] tabular-nums\">\n                    1. MIESTO\n                  </div>\n                </div>\n\n                {/* Main Award Centerpiece */}\n                <div className=\"mt-7 grid grid-cols-1 items-center gap-7 sm:grid-cols-12\">\n                  <div className=\"flex flex-col items-center sm:col-span-4\">\n                    <RadoPortraitFrame\n                      src={radoPhotoUrl || DEFAULT_RADO_PORTRAIT_URL}\n                      sizeClass=\"h-44 w-44 border-2 border-[#e5b94c]\"\n                    />\n                    <div className=\"mt-2.5 font-mono text-[11px] text-[#00e8e8]\">\n                      Laure\303\241t regi\303\263nu Gemer-Malohont\n                    </div>\n                  </div>\n\n                  <div className=\"sm:col-span-8\">\n                    <div className=\"font-mono text-xs text-[#9aa5b8]\">\n                      T\303\275mto s \303\272ctou a v\304\217akou odovzd\303\241vame ocenenie\n                    </div>\n                    <h3 className=\"mt-1.5 font-display text-4xl font-bold tracking-tight text-white sm:text-5xl\">\n                      Rado Cegl\303\251dy\n                    </h3>\n                    <div className=\"mt-2 font-mono text-base font-bold text-[#e5b94c]\">\n                      Celo\305\276ivotn\303\275 MVP v regi\303\263ne\n                    </div>\n                    <p className=\"mt-4 text-sm leading-relaxed text-[#cfd7e3]\">\n                      Za mimoriadnu energiu, \304\276udskos\305\245, technologick\303\251 v\303\255zie a ka\305\276dodenn\303\272 pr\303\241cu, ktor\303\241 pos\303\272va Rimavsk\303\272 Sobotu a cel\303\275 n\303\241\305\241 regi\303\263n vpred \342\200\224 od modern\303\251ho zdravia v{\' \'}\n                      <strong className=\"text-white\">microDENT.sk</strong> cez optick\303\272 bud\303\272cnos\305\245{\' \'}\n                      <strong className=\"text-white\">TeatrO.eu</strong> a\305\276 po in\305\241pir\303\241ciu pre cel\303\272 komunitu.\n                    </p>\n                  </div>\n                </div>\n\n                {/* Bottom Signatures & Emblems */}\n                <div className=\"mt-8 flex flex-wrap items-center justify-between gap-5 border-t border-[#252e42] pt-5\">\n                  <div className=\"flex flex-wrap items-center gap-5\">\n                    <MicrodentLogo compact />\n                    <TeatroLogo compact />\n                  </div>\n                  <div className=\"text-right\">\n                    <div className=\"font-sans text-sm font-semibold text-white\">\n                      Skupina ob\304\215anov regi\303\263nu Rimavsk\303\241 Sobota\n                    </div>\n                    <div className=\"font-mono text-[11px] text-[#9aa5b8]\">\n                      Venovan\303\251 ako prejav \303\272cty a v\304\217aky \302\267 Hra Z\303\272bok a sign\303\241lik\n                    </div>\n                    <div className=\"mt-1.5 font-mono text-xs font-bold tracking-widest text-[#00e8e8]\">\n                      TAJN\303\235 K\303\223D 1270: {SECRET_CODE}\n                    </div>\n       "
    num_lines: 971
    num_bytes: 54320
    line_range_bytes: 54320
  }
}
