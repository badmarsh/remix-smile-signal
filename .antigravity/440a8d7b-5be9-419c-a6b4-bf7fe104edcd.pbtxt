            }
            lines {
              text: "export function tokenizeBasicLine(line: string): Uint8Array {"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "  const match = line.trim().match(/^(\\d+)\\s+(.*)$/);"
