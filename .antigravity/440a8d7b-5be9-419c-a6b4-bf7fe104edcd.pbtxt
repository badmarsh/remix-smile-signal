              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "function isAlpha(ch: string): boolean {"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "  return (ch >= \'A\' && ch <= \'Z\') || (ch >= \'a\' && ch <= \'z\');"
