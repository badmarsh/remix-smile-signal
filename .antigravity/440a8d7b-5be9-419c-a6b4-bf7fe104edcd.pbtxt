            }
            lines {
              text: "  // Standard ZX Spectrum = 3.50 MHz; Didaktik M clock = 4.00 MHz (Wait-state compensated ~3.5-3.85 MHz)"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
