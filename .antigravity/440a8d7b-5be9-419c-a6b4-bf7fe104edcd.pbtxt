\", timeout: 15000 });  // Close Manual -> press K for Secret Room 1270 -> test invalid code -> test valid code unlock!  await page.keyboard.press(\"Escape\");  await page.waitForTimeout(150);  await page.keyboard.press(\"KeyK\");  await page.waitForTimeout(200);  const input = page.locator(\"input\").first();  await input.fill(\"WRONG123\");  await page.getByRole(\"button\", { name: /Odomkn\303\272\305\245/i }).click();  await page.waitForTimeout(150);  const errVisible = await page.getByText(/Nespr\303\241vny|Neplatn\303\275/i).isVisible();  if (!errVisible) throw new Error(\"Invalid code did not show error!\");  await input.fill(codeText);  await page.getByRole(\"button\", { name: /Odomkn\303\272\305\245/i }).click();  await page.waitForTimeout(200);  await page.screenshot({ path: \".playwright-cli/v3-r2h-secret-unlocked.png\", timeout: 15000 });  return \"VERIFIED_MANUAL_AND_SECRET_ROOM:\" + codeText;})(page);```### ResultTotal messages: 3 (Errors: 0, Warnings: 0)Returning 1 messages for level \"info\"[INFO] %cDownload the React DevTools for a better development experience: https://react.dev/link/react-devtools font-weight:bold @ http://localhost:3000/node_modules/.vite/deps/react-dom_client.js?v=21c0e130:15801Browser \'default\' closed\n\n### Latest snapshot (.playwright-cli/page-2026-11-20T00-31-10-736Z.yml)\n```yaml\n- main [ref=e3]:\n  - generic \"Retro obrazovka Didaktik M 256 kr\303\241t 192\" [ref=e6]\n  - dialog \"Nahr\303\241vanie kazety Didaktik M\" [ref=e7] [cursor=pointer]:\n    - generic [ref=e9]:\n      - generic:\n        - generic: \302\251 1990 Didaktik Skalica \302\267 48K\n        - generic: LOAD \"\"\n    - generic [ref=e11]:\n      - generic [ref=e12]: LOAD \"\" \302\267 PILOTN\303\235 T\303\223N 806 Hz\n      - button \"Presko\304\215i\305\245 [\304\275ubovo\304\276n\303\241 kl\303\241vesa]\" [ref=e13]\n```\n\n### Log (.playwright-cli/console-2026-11-20T00-31-08-802Z.log#L1-L1)\n```\n[     375ms] [INFO] %cDownload the React DevTools for a b