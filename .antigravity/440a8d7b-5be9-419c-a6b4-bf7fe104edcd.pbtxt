  view_file {
    absolute_path_uri: "file:///src/data/signatures.ts"
    end_line: 92
    content: "/**\n * Kniha podpisov ob\304\215anov regi\303\263nu Rimavsk\303\241 Sobota + deterministick\303\275 tajn\303\275 k\303\263d pre Miestnos\305\245 1270.\n * Objavuje sa v:\n *  a) z\303\241vere\304\215n\303\275ch titulkoch cerem\303\263nie v hre (256\303\227192)\n *  b) tla\304\215ite\304\276nej zberate\304\276skej karte 63\303\22788 mm (Vizu\303\241lny manu\303\241l \302\267 Kapitola 06)\n *  c) Deluxe kazete .TAP/.WAV ako Sinclair BASIC DATA riadky (sanitizovan\303\251 cez sanitizeZxString)\n */\n\nimport { sanitizeZxString } from \'../didaktik/basicSource\';\nimport { SECRET_CODE_SEED } from \'./dedication\';\n\n// TODO: nahradi\305\245 skuto\304\215n\303\275mi menami ob\304\215anov\nexport const CITIZEN_SIGNATURES: string[] = [\n  \'Marek \302\267 Rimavsk\303\241 Sobota\',\n  \'Peter \302\267 Kurinec\',\n  \'Jana \302\267 Hatvaniho ulica\',\n  \'Zuzka \302\267 Hlavn\303\251 n\303\241mestie\',\n  \'Martin \302\267 Gemer-Malohont\',\n  \'Tom\303\241\305\241 \302\267 RSNET komunita\',\n  \'Katar\303\255na \302\267 microDENT t\303\255m\',\n  \'Luk\303\241\305\241 \302\267 TeatrO priatelia\',\n  \'Michal \302\267 Star\303\251 mesto RS\',\n  \'Eva \302\267 Zelen\303\241 voda\',\n  \'D\303\241vid \302\267 Sobotsk\303\241 partia\',\n  \'A v\305\241etci ob\304\215ania regi\303\263nu RS\',\n];\n\nconst CODE_ALPHABET = \'ABCDEFGHJKLMNPQRSTUVWXYZ23456789\';\n\n/**\n * Generates a deterministic 8-character secret code (uppercase alphanumeric, no ambiguous 0/O/1/I)\n * from a seed string. Printed on the MVP Plaque & Collector Card and unlocks Secret Room 1270.\n */\nexport function deriveSecretCode(seed: string = SECRET_CODE_SEED): string {\n  let h1 = 0x811c9dc5;\n  let h2 = 0x9e3779b1;\n  for (let i = 0; i < seed.length; i++) {\n    const ch = seed.charCodeAt(i);\n    h1 ^= ch;\n    h1 = Math.imul(h1, 0x01000193) >>> 0;\n    h2 = Math.imul(h2 ^ (ch + i * 17), 0x85ebca6b) >>> 0;\n  }\n\n  let code = \'\';\n  let state = (h1 ^ h2) >>> 0;\n  for (let i = 0; i < 8; i++) {\n    state = (Math.imul(state, 1664525) + 1013904223 + i * 97) >>> 0;\n    const idx = (state >>> 16) % CODE_ALPHABET.length;\n    code += CODE_ALPHABET[idx];\n  }\n  return code;\n}\n\nexport function normalizeSecretCode(input: string): string {\n  return input.toUpperCase().replace(/[^A-Z0-9]/g, \'\');\n}\n\nexport function validateSecretCode(input: string, seed: string = SECRET_CODE_SEED): boolean {\n  const normalized = normalizeSecretCode(input);\n  if (normalized.length !== 8) return false;\n  return normalized === deriveSecretCode(seed);\n}\n\n/**\n * Formats citizen signatures as safe Sinclair BASIC DATA lines (sanitized ASCII, no diacritics)\n * for appending to the Deluxe cassette ending screen without touching buildTapFile.\n */\nexport function formatSignaturesAsBasicData(\n  signatures: readonly string[] = CITIZEN_SIGNATURES,\n  startLine = 9100\n): string[] {\n  const lines: string[] = [];\n  let lineNo = startLine;\n  lines.push(`${lineNo} REM KNIHA PODPISOV OBCANOV RS`);\n  lineNo += 10;\n\n  const cleanNames = signatures\n    .map((s) => sanitizeZxString(s, 28))\n    .filter((s) => s.length > 0);\n\n  for (let i = 0; i < cleanNames.length; i += 2) {\n    const pair = cleanNames\n      .slice(i, i + 2)\n      .map((name) => `\"${name}\"`)\n      .join(\',\');\n    lines.push(`${lineNo} DATA ${pair}`);\n    lineNo += 10;\n  }\n\n  lines.push(`${lineNo} DATA \"END\"`);\n  return lines;\n}\n"
    num_lines: 93
