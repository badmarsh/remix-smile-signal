    tool_calls {
      id: "call_4442340969038768352"
      name: "multi_replace_file_content"
      arguments_json: "{\"Description\":\"Verify Deluxe BASIC ending signature routine routing, unaltered buildTapFile, and chronicle <= 56 chars & zero ARTFAKT typos in citizens.test.ts\", \"Instruction\":\"Import generateSinclairBasicLines and assert Deluxe line 795->9000 routing, unchanged base BASIC, and Slovak chronicle length/spelling invariants\", \"ReplacementChunks\":[{\"AllowMultiple\":false, \"EndLine\":12, \"ReplacementContent\":\"import { DEFAULT_TAPE_CONFIG, generateSinclairBasicLines } from \'../didaktik/basicSource\';\\nimport { buildDeluxeTapFile, parseTap, tokenizeBasicLine } from \'../didaktik/tapeBuilder\';\", \"StartLine\":9, \"TargetContent\":\"import { DEFAULT_TAPE_CONFIG } from \'../didaktik/basicSource\';\\nimport { buildDeluxeTapFile, parseTap, tokenizeBasicLine } from \'../didaktik/tapeBuilder\';\"}, {\"AllowMultiple\":false, \"EndLine\":99, \"ReplacementContent\":\"test(\'formatSignaturesAsBasicData produces executable 9000-9030 reader + DATA lines for Deluxe .TAP without altering base BASIC\', () => {\\n  const dataLines = formatSignaturesAsBasicData(CITIZEN_SIGNATURES);\\n  assert.ok(dataLines.length >= 7);\\n  assert.ok(dataLines.some((l) => l.startsWith(\'9000 RESTORE 9100\')));\\n  assert.ok(dataLines.some((l) => l.startsWith(\'9010 READ N$\')));\\n\\n  for (const line of dataLines) {\\n    // Must contain only safe ASCII chars\\n    assert.match(line, /^[\\\\x20-\\\\x7e]+$/, `Non-ASCII char leaked into BASIC line: ${line}`);\\n    const tokenized = tokenizeBasicLine(line);\\n    assert.ok(tokenized.length > 4);\\n  }\\n\\n  // Original generateSinclairBasicLines stays untouched\\n  const baseLines = generateSinclairBasicLines(DEFAULT_TAPE_CONFIG);\\n  assert.ok(baseLines.includes(\'795 PAUSE 0: GOTO 30\'));\\n\\n  // Embed cleanly in buildDeluxeTapFile, routes 795 -> GOTO 9000, and validates all 6 block checksums\\n  const blankScreen = new Uint8Array(6912);\\n  const deluxe = buildDeluxeTapFile(DEFAULT_TAPE_CONFIG, blankScreen, dataLines);\\n  assert.ok(deluxe.gameLines.includes(\'795 PAUSE 120: GOTO 9000\'));\\n  const parsed = parseTap(deluxe.tapBytes);\\n  assert.equal(parsed.length, 6);\\n  for (const blk of parsed) {\\n    assert.equal(blk.checksumValid, true);\\n  }\\n});\\n\\ntest(\'all stage openingChronicle and relic chronicleNote texts are <= 56 chars and free of ARTFAKT typo\', () => {\\n  for (const stage of STAGES) {\\n    assert.ok(\\n      stage.openingChronicle.length <= 56,\\n      `Stage ${stage.index} openingChronicle > 56 chars: ${stage.openingChronicle}`\\n    );\\n    assert.ok(\\n      stage.relic.chronicleNote.length <= 56,\\n      `Stage ${stage.index} relic.chronicleNote > 56 chars: ${stage.relic.chronicleNote}`\\n    );\\n    assert.equal(stage.relic.chronicleNote.includes(\'ARTFAKT\'), false);\\n    assert.equal(stage.openingChronicle.includes(\'ARTFAKT\'), false);\\n  }\\n});\", \"StartLine\":80, \"TargetContent\":\"test(\'formatSignaturesAsBasicData produces sanitized BASIC DATA lines usable in Deluxe .TAP\', () => {\\n  const dataLines = formatSignaturesAsBasicData(CITIZEN_SIGNATURES);\\n  assert.ok(dataLines.length >= 3);\\n  for (const line of dataLines) {\\n    // Must contain only safe ASCII chars\\n    assert.match(line, /^[\\\\x20-\\\\x7e]+$/, `Non-ASCII char leaked into BASIC line: ${line}`);\\n    const tokenized = tokenizeBasicLine(line);\\n    assert.ok(tokenized.length > 4);\\n  }\\n\\n  // Embed cleanly in buildDeluxeTapFile and validate all 6 block checksums\\n  const blankScreen = new Uint8Array(6912);\\n  const deluxe = buildDeluxeTapFile(DEFAULT_TAPE_CONFIG, blankScreen, dataLines);\\n  const parsed = parseTap(deluxe.tapBytes);\\n  assert.equal(parsed.length, 6);\\n  for (const blk of parsed) {\\n    assert.equal(blk.checksumValid, true);\\n  }\\n});\"}], \"TargetFile\":\"/src/game/citizens.test.ts\", \"toolAction\":\"Adding BASIC routing and Slovak invariants tests in citizens.test.ts\", \"toolSummary\":\"Update citizens.test.ts\"}"
      original_name: "multi_replace_file_content"
    }
