torage/r8-manual-03-fixed.png\n/.aistudio/artifacts/brain/01c7a43b-cf52-4542-aaf1-533019e4dd9e/.tempmediaStorage/r8-manual-05.png\n/.aistudio/artifacts/brain/01c7a43b-cf52-4542-aaf1-533019e4dd9e/.tempmediaStorage/v2-manual-card.png\n/.aistudio/artifacts/brain/01c7a43b-cf52-4542-aaf1-533019e4dd9e/.tempmediaStorage/v2-manual-plaque.png\n/.aistudio/artifacts/brain/01c7a43b-cf52-4542-aaf1-533019e4dd9e/.tempmediaStorage/v2-tapekit-fixed.png\n/.env.example\n/.gitignore\n/README.md\n/bun.lock\n/index.html\n/metadata.json\n/package.json\n/public/assets/aistudio/image_3bf278e7.png\n/scripts/run-tests.mjs\n/src/App.tsx\n/src/assets/images/mvp_plaque_trophy_1795115616768.jpg\n/src/assets/images/physical_edition_box_1795115575355.jpg\n/src/assets/images/rado_portrait_techno_1795115581925.jpg\n/src/components/AssetStudioPanels.tsx\n/src/components/BrandEmblems.tsx\n/src/components/CassetteIntroOverlay.tsx\n/src/components/GameHud.tsx\n/src/components/SecretRoomModal.tsx\n/src/components/StatusModal.tsx\n/src/components/TapeKitModal.tsx\n/src/components/TitleOverlay.tsx\n/src/components/VisualManualModal.tsx\n/src/data/dedication.ts\n/src/data/signatures.ts\n/src/didaktik/assets.test.ts\n/src/didaktik/basicSource.ts\n/src/didaktik/chiptuneAssets.ts\n/src/didaktik/specs.ts\n/src/didaktik/tapeBuilder.test.ts\n/src/didaktik/tapeBuilder.ts\n/src/didaktik/udgAssets.ts\n/src/didaktik/zxScreen.test.ts\n/src/didaktik/zxScreen.ts\n/src/didaktik/zxScreenCompose.ts\n/src/game/audio.ts\n/src/game/boss.test.ts\n/src/game/citizens.test.ts\n/src/game/citizens.ts\n/src/game/coop.test.ts\n/src/game/engine.test.ts\n/src/game/engine.ts\n/src/game/levels.ts\n/src/game/music.test.ts\n/src/game/music.ts\n/src/game/progress.test.ts\n/src/game/progress.ts\n/src/game/renderer.ts\n/src/game/sprites.ts\n/src/game/stages.test.ts\n/src/game/types.ts\n/src/index.css\n/src/main.tsx\n/tsconfig.json\n/vite.config.ts\n\nThe following dependencies are installed:\n@fontsource/dm-sans: ^5.3.0\n@fontsource/jetbrains-mono: ^5.3.0\n@fontsource/pixelify-sans: ^5.3.0\n@tailwindcss/vite: ^4.3.3\n@vitejs/plugin-react: ^6.1.1\nlucide-react: ^0.546.0\nmotion: ^12.23.24\nreact: ^19.0.1\nreact-dom: ^19.0.1\nvite: ^8.3.0\n\nThe following devDependencies are installed:\n@types/node: ^22.14.0\n@types/react: ^19.3.0\n@types/react-dom: ^19.3.0\nautoprefixer: ^10.4.21\nesbuild: ^0.25.0\ntailwindcss: ^4.3.3\ntsx: ^4.21.0\ntypescript: ^7.0.2\n\nKey file contents:\n\n--- /.env.example ---\n```\n# GEMINI_API_KEY: Required for Gemini AI API calls.\n# AI Studio automatically injects this at runtime from user secrets.\n# Users configure this via the Secrets panel in the AI Studio UI.\nGEMINI_API_KEY=\"MY_GEMINI_API_KEY\"\n\n# APP_URL: The URL where this applet is hosted.\n# AI Studio automatically injects this at runtime with the Cloud Run service URL.\n# Used for self-referential links, OAuth callbacks, and API endpoints.\nAPP_URL=\"MY_APP_URL\"\n\n```\n\n--- /index.html ---\n```html\n<!doctype html>\n<html lang=\"sk\">\n  <head>\n    <meta charset=\"UTF-8\" />\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\n    <title>Z\303\272bok a sign\303\241lik \342\200\224 Didaktik M \302\267 Venovan\303\251 Radovi Cegl\303\251dymu</title>\n    <meta name=\"description\" content=\"Retro hra pre Didaktik M a techno-futuristick\303\275 vizu\303\241lny manu\303\241l venovan\303\275 Radovi Cegl\303\251dymu (1. miesto Celo\305\276ivotn\303\275 MVP regi\303\263nu Rimavsk\303\241 Sobota) pre microDENT.sk a TeatrO.eu.\" />\n    <meta property=\"og:title\" content=\"Z\303\272bok a sign\303\241lik \342\200\224 Didaktik M \302\267 Rado Cegl\303\251dy MVP Ed\303\255cia\" />\n    <meta property=\"og:description\" content=\"Retro ark\303\241da pre Didaktik M s magnetickou kazetou (.TAP/.WAV) a techno-futuristick\303\275m vizu\303\241lnym manu\303\241lom od ob\304\215anov regi\303\263nu Rimavsk\303\241 Sobota.\" />\n    <meta property=\"og:type\" content=\"website\" />\n    <meta name=\"twitter:card\" content=\"summary_large_image\" />\n  </head>\n  <body class=\"bg-[#0d0f14] text-[#ebe9e3] antialiased selection:bg-[#00d8d8]/30 selection:text-white\">\n    <div id=\"root\"></div>\n    <script type=\"module\" src=\"/src/main.tsx\"></script>\n  </body>\n</html>\n\n\n```\n\n--- /metadata.json ---\n```json\n{\n  \"name\": \"Remix Smile \\u0026 Signal \342\200\224 Didaktik M Christmas Edition\",\n  \"description\": \"A retro Didaktik M (ZX Spectrum 48K) Christmas arcade game and native magnetic cassette (.TAP/.WAV) studio inspired by microDENT.sk and TeatrO.eu.\",\n  \"requestFramePermissions\": [],\n  \"majorCapabilities\": [\n    \"MAJOR_CAPABILITY_SERVER_SIDE_GEMINI_API\"\n  ]\n}\n```\n\n--- /src/App.tsx ---\n```typescript\nimport { useCallback, useEffect, useRef, useState } from \'react\';\nimport { DEFAULT_RADO_PORTRAIT_URL } from \'./components/BrandEmblems\';\nimport { CassetteIntroOverlay } from \'./components/CassetteIntroOverlay\';\nimport { GameHud } from \'./components/GameHud\';\nimport { SecretRoomModal } from \'./components/SecretRoomModal\';\nimport { StatusModal } from \'./components/StatusModal\';\nimport { KitTab, TapeKitModal } from \'./components/TapeKitModal\';\nimport { TitleOverlay } from \'./components/TitleOverlay\';\nimport { VisualManualModal } from \'./components/VisualManualModal\';\nimport { CITIZEN_SIGNATURES, formatSignaturesAsBasicData } from \'./data/signatures\';\nimport { BasicProgramConfig, DEFAULT_TAPE_CONFIG } from \'./didaktik/basicSource\';\nimport { DEFAULT_UDG_PACK, DidaktikUdgAsset } from \'./didaktik/udgAssets\';\nimport { createZxQuantizedPortraitCanvas } from \'./didaktik/zxScreenCompose\';\nimport { didaktikAudio } from \'./game/audio\';\nimport {\n  advanceHandoverToVictory,\n  continueFromCheckpoint,\n  createWorld,\n  drainAudioQueue,\n  getHudSnapshot,\n  restartCurrentRun,\n  setRadoPokeMode,\n  startNewGame,\n  stepWorld,\n  swapActiveHero,\n} from \'./game/engine\';\nimport { loadSavedProgress, saveProgress } from \'./game/progress\';\nimport { LOGICAL_H, LOGICAL_W, renderDidaktikFrame } from \'./game/renderer\';\nimport { AudioChipMode, GameWorld, HudSnapshot, InputState } from \'./game/types\';\n\nconst BEST_SCORE_KEY = \'smile_signal_didaktik_best_v1\';\nconst CUSTOM_RADO_PHOTO_KEY = \'zubok_signalik_rado_photo_v1\';\n\nfunction readStoredBestScore(): number {\n  try {\n    const raw = window.localStorage.getItem(BEST_SCORE_KEY);\n    const parsed = raw ? parseInt(raw, 10) : 0;\n    return Number.isFinite(parsed) && parsed > 0 ? parsed : 0;\n  } catch {\n    return 0;\n  }\n}\n\nfunction writeStoredBestScore(score: number): void {\n  try {\n    window.localStorage.setItem(BEST_SCORE_KEY, String(Math.round(score)));\n  } catch {\n    // Ignore storage quota errors\n  }\n}\n\nfunction readStoredRadoPhoto(): string | null {\n  try {\n    return window.localStorage.getItem(CUSTOM_RADO_PHOTO_KEY);\n  } catch {\n    return null;\n  }\n}\n\nfunction shouldAutostart(): boolean {\n  try {\n    const params = new URLSearchParams(window.location.search);\n    return params.get(\'autostart\') === \'1\';\n  } catch {\n    return false;\n  }\n}\n\nfunction toBodyDatasetState(phase: GameWorld[\'phase\']): string {\n  if (phase === \'title\') return \'title\';\n  if (phase === \'paused\') return \'paused\';\n  if (phase === \'victory\' || phase === \'gameover\') return \'gameover\';\n  return \'playing\';\n}\n\nexport default function App() {\n  const canvasRef = useRef<HTMLCanvasElement | null>(null);\n  const worldRef = useRef<GameWorld | null>(null);\n  const crtEnabledRef = useRef(true);\n  const modalBlockingRef = useRef(false);\n  const radoPixelCanvasRef = useRef<HTMLCanvasElement | null>(null);\n  const keysHeldRef = useRef<Set<string>>(new Set());\n  const fireJustPressedRef = useRef(false);\n  const dashJustPressedRef = useRef(false);\n  const swapJustPressedRef = useRef(false);\n\n  const [tapeConfig, setTapeConfig] = useState<BasicProgramConfig>(DEFAULT_TAPE_CONFIG);\n  const [udgPack, setUdgPack] = useState<DidaktikUdgAsset[]>(DEFAULT_UDG_PACK);\n  const [tapeKitOpen, setTapeKitOpen] = useState(false);\n  const [visualManualOpen, setVisualManualOpen] = useState(false);\n  const [secretRoomOpen, setSecretRoomOpen] = useState(false);\n  const [kitInitialTab, setKitInitialTab] = useState<KitTab>(\'cassette\');\n  const [muted, setMuted] = useState(false);\n  const [chipMode, setChipMode] = useState<AudioChipMode>(() => didaktikAudio.getChipMode());\n  const [crtEnabled, setCrtEnabled] = useState(true);\n  const [introVisible, setIntroVisible] = useState(() => !shouldAutostart());\n  const [customRadoPhoto, setCustomRadoPhoto] = useState<string | null>(() => readStoredRadoPhoto());\n\n  const activeRadoPhotoUrl = customRadoPhoto || DEFAULT_RADO_PORTRAIT_URL;\n\n  if (!worldRef.current) {\n    const initialPhase = shouldAutostart() ? \'playing\' : \'title\';\n    const saved = loadSavedProgress(\n      typeof window !== \'undefined\' ? window.localStorage : null\n    );\n    const best = Math.max(readStoredBestScore(), saved.bestScore);\n    const created = createWorld(initialPhase, best);\n    if (saved.radoPokeMode) {\n      setRadoPokeMode(created, true);\n    }\n    created.checkpointStageIndex = saved.checkpointStageIndex;\n    created.checkpointScore = saved.checkpointScore;\n    created.stageLosses = { ...saved.stageLosses };\n    worldRef.current = created;\n  }\n\n  const [hud, setHud] = useState<HudSnapshot>(() => getHudSnapshot(worldRef.current!));\n\n  useEffect(() => {\n    modalBlockingRef.current = tapeKitOpen || visualManualOpen || secretRoomOpen || introVisible;\n  }, [tapeKitOpen, visualManualOpen, secretRoomOpen, introVisible]);\n\n  // Pre-render Rado\'s photo into a strictly ZX_PALETTE quantized 24x24 pixel-art offscreen canvas\n  useEffect(() => {\n    let cancelled = false;\n    const img = new Image();\n    img.crossOrigin = \'anonymous\';\n    img.onload = () => {\n      if (cancelled) return;\n      radoPixelCanvasRef.current = createZxQuantizedPortraitCanvas(img, 24);\n    };\n    img.src = activeRadoPhotoUrl;\n    return () => {\n      cancelled = true;\n    };\n  }, [activeRadoPhotoUrl]);\n\n  const handleUploadRadoPhoto = useCallback((dataUrl: string) => {\n    setCustomRadoPhoto(dataUrl);\n    try {\n      window.localStorage.setItem(CUSTOM_RADO_PHOTO_KEY, dataUrl);\n    } catch {\n      // Ignore quota exceeded for very large files; state still updates live\n    }\n  }, []);\n\n  const handleResetRadoPhoto = useCallback(() => {\n    setCustomRadoPhoto(null);\n    try {\n      window.localStorage.removeItem(CUSTOM_RADO_PHOTO_KEY);\n    } catch {\n      // Ignore storage errors\n    }\n  }, []);\n\n  const persistWorldProgress = useCallback((world: GameWorld) => {\n    saveProgress(\n      {\n        checkpointStageIndex: world.checkpointStageIndex,\n        checkpointScore: world.checkpointScore,\n        bestScore: world.bestScore,\n        radoPokeMode: world.radoPokeMode,\n        stageLosses: world.stageLosses,\n      },\n      typeof window !== \'undefined\' ? window.localStorage : null\n    );\n  }, []);\n\n  const syncHudNow = useCallback(() => {\n    const world = worldRef.current;\n    if (!world) return;\n    document.body.dataset.state = toBodyDatasetState(world.phase);\n    if (world.bestScore > readStoredBestScore()) {\n      writeStoredBestScore(world.bestScore);\n    }\n    persistWorldProgress(world);\n    setHud(getHudSnapshot(world));\n  }, [persistWorldProgress]);\n\n  const clearInputs = useCallback(() => {\n    keysHeldRef.current.clear();\n    fireJustPressedRef.current = false;\n    dashJustPressedRef.current = false;\n    swapJustPressedRef.current = false;\n  }, []);\n\n  const handleStart = useCallback(() => {\n    const world = worldRef.current;\n    if (!world) return;\n    clearInputs();\n    startNewGame(world);\n    syncHudNow();\n    canvasRef.current?.focus();\n  }, [clearInputs, syncHudNow]);\n\n  const handleRestart = useCallback(() => {\n    const world = worldRef.current;\n    if (!world) return;\n    clearInputs();\n    restartCurrentRun(world);\n... (truncated)\n```\n\n--- /src/index.css ---\n```css\n@import \"tailwindcss\";\n\n@theme {\n  --font-display: \"Pixelify Sans\", \"JetBrains Mono\", monospace;\n  --font-sans: \"DM Sans\", system-ui, -apple-system, sans-serif;\n  --font-mono: \"JetBrains Mono\", ui-monospace, monospace;\n}\n\n@layer base {\n  html,\n  body,\n  #root {\n    height: 100%;\n    margin: 0;\n    padding: 0;\n    background-color: #0d0f14;\n    color: #ebe9e3;\n    font-family: var(--font-sans);\n    overflow: hidden;\n  }\n}\n\n.pixel-canvas {\n  image-rendering: pixelated;\n  image-rendering: crisp-edges;\n}\n\n.tabular-nums {\n  font-variant-numeric: tabular-nums;\n}\n\n.hud-text-stroke {\n  text-shadow:\n    0 2px 0 rgba(0, 0, 0, 0.9),\n    0 0 8px rgba(0, 0, 0, 0.7);\n}\n\n@media print {\n  html,\n  body,\n  #root {\n    height: auto !important;\n    overflow: visible !important;\n    background: #0a0d14 !important;\n    -webkit-print-color-adjust: exact;\n    print-color-adjust: exact;\n  }\n\n  .no-print {\n    display: none !important;\n  }\n\n  .manual-modal-root {\n    position: static !important;\n    background: #0a0d14 !important;\n    padding: 0 !important;\n  }\n\n  .manual-sheet {\n    max-height: none !important;\n    overflow: visible !important;\n    border: none !important;\n    box-shadow: none !important;\n  }\n}\n\n```\n\n--- /src/main.tsx ---\n```typescript\nimport \'@fontsource/dm-sans/400.css\';\nimport \'@fontsource/dm-sans/500.css\';\nimport \'@fontsource/dm-sans/600.css\';\nimport \'@fontsource/dm-sans/700.css\';\nimport \'@fontsource/jetbrains-mono/400.css\';\nimport \'@fontsource/jetbrains-mono/500.css\';\nimport \'@fontsource/jetbrains-mono/600.css\';\nimport \'@fontsource/jetbrains-mono/700.css\';\nimport \'@fontsource/pixelify-sans/600.css\';\nimport \'@fontsource/pixelify-sans/700.css\';\nimport {createRoot} from \'react-dom/client\';\nimport App from \'./App.tsx\';\nimport \'./index.css\';\n\ncreateRoot(document.getElementById(\'root\')!).render(<App />);\n\n```\n\n--- /tsconfig.json ---\n```json\n{\n  \"compilerOptions\": {\n    \"target\": \"ES2022\",\n    \"experimentalDecorators\": true,\n    \"useDefineForClassFields\": false,\n    \"module\": \"ESNext\",\n    \"types\": [\"vite/client\"],\n    \"lib\": [\n      \"ES2022\",\n      \"DOM\",\n      \"DOM.Iterable\"\n    ],\n    \"skipLibCheck\": true,\n    \"moduleResolution\": \"bundler\",\n    \"isolatedModules\": true,\n    \"moduleDetection\": \"force\",\n    \"allowJs\": true,\n    \"jsx\": \"react-jsx\",\n    \"paths\": {\n      \"@/*\": [\n        \"./*\"\n      ]\n    },\n    \"allowImportingTsExtensions\": true,\n    \"noEmit\": true\n  },\n  \"exclude\": [\"dist\"]\n}\n\n```\n\n--- /vite.config.ts ---\n```typescript\nimport tailwindcss from \'@tailwindcss/vite\';\nimport react from \'@vitejs/plugin-react\';\nimport fs from \'fs\';\nimport path from \'path\';\nimport {defineConfig} from \'vite\';\n\nexport default defineConfig(() => {\n  return {\n    base: \'./\',\n    plugins: [\n      react(),\n      tailwindcss(),\n      // Copies src/assets into dist/ so root-relative URLs like\n      // \"/src/assets/images/...\" (e.g. generate_image output) still resolve\n      // in production builds. Do not remove.\n      {\n        name: \'copy-unbundled-src-assets\',\n        apply: \'build\',\n        closeBundle(error?: Error): void {\n          if (error) {\n            return;\n          }\n          const distDir = path.resolve(__dirname, \'dist\');\n          const srcAssets = path.resolve(__dirname, \'src/assets\');\n          const distAssets = path.resolve(distDir, \'src/assets\');\n          if (fs.existsSync(distDir) && fs.existsSync(srcAssets)) {\n            fs.cpSync(srcAssets, distAssets, {recursive: true, force: true});\n          }\n        },\n      },\n    ],\n    resolve: {\n      alias: {\n        \'@\': path.resolve(__dirname, \'.\'),\n      },\n    },\n    server: {\n      // HMR is disabled in AI Studio via DISABLE_HMR env var.\n      // Do not modify\342\200\224file watching is disabled to prevent flickering during agent edits.\n      hmr: process.env.DISABLE_HMR !== \'true\',\n      // Disable file watching when DISABLE_HMR is true to save CPU during agent edits.\n      watch: process.env.DISABLE_HMR === \'true\' ? null : {},\n    },\n  };\n});\n\n```"
