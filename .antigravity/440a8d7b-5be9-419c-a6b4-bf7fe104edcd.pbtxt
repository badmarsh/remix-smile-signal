            }
            lines {
              text: "  if (!match) {"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    throw new Error(`Invalid Sinclair BASIC line (missing line number): ${line}`);"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
