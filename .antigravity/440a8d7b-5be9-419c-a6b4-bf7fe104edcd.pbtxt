  view_file {
    absolute_path_uri: "file:///src/game/citizens.ts"
    end_line: 176
    content: "/**\n * Ob\304\215ania regi\303\263nu Rimavsk\303\241 Sobota ako priate\304\276sk\303\251 NPC v \305\241t\303\275le Dizzy/Towdie (1\342\200\2232 na kolo).\n * Ke\304\217 sa hr\303\241\304\215 pribl\303\255\305\276i, zobraz\303\255 sa ich kr\303\241tka hl\303\241\305\241ka (max 56 znakov) na 3,0 sekundy bez extra tla\304\215idla.\n */\n\nexport interface CitizenNpc {\n  id: string;\n  stageIndex: number;\n  name: string;\n  role: string;\n  quote: string; // max 56 chars\n  x: number;\n  y: number;\n}\n\nexport interface CitizenSpeechState {\n  activeCitizenId: string | null;\n  activeName: string;\n  activeQuote: string;\n  timer: number;\n  /** Cooldown per citizen ID so standing beside an NPC doesn\'t re-trigger immediately */\n  cooldowns: Record<string, number>;\n}\n\nexport const CITIZEN_TRIGGER_RADIUS = 18;\nexport const CITIZEN_SPEECH_DURATION = 3.0;\nexport const CITIZEN_RETRIGGER_COOLDOWN = 6.0;\n\n// TODO: nahradi\305\245 skuto\304\215n\303\275mi menami a hl\303\241\305\241kami ob\304\215anov\nexport const STAGE_CITIZENS: readonly CitizenNpc[] = [\n  // Stage 1: Klinika microDENT\n  {\n    id: \'c1_clinic\',\n    stageIndex: 0,\n    name: \'Jana\',\n    role: \'Pacientka z Hatvaniho\',\n    quote: \'Rad\305\241ej kaz v hre ne\305\276 v \303\272stach.\',\n    x: 92,\n    y: 92,\n  },\n  {\n    id: \'c2_clinic\',\n    stageIndex: 0,\n    name: \'Marek\',\n    role: \'Sused z RS\',\n    quote: \'V microDENTe svieti UV l\303\272\304\215 \342\200\223 po\304\215kaj, k\303\275m zhasne!\',\n    x: 164,\n    y: 92,\n  },\n  // Stage 2: Endo & 3D CBCT Lab\n  {\n    id: \'c3_endo\',\n    stageIndex: 1,\n    name: \'Katar\303\255na\',\n    role: \'Asistentka\',\n    quote: \'Cez CBCT l\303\272\304\215 prebehni Saboteur \303\272hybom [Shift]!\',\n    x: 84,\n    y: 132,\n  },\n  // Stage 3: Optick\303\275 uzol TeatrO\n  {\n    id: \'c4_teatro\',\n    stageIndex: 2,\n    name: \'Tom\303\241\305\241\',\n    role: \'Technik RSNET\',\n    quote: \'Vl\303\241kna zap\303\241jaj po poriadku 1 a\305\276 7 ako v Atomixe!\',\n    x: 172,\n    y: 92,\n  },\n  // Stage 4: Rieka Rimava & Kurinec\n  {\n    id: \'c5_rimava\',\n    stageIndex: 3,\n    name: \'Peter\',\n    role: \'Cyklista z Kurinca\',\n    quote: \'Zelen\303\241 voda je dnes hladk\303\241 ako optika na 10G.\',\n    x: 124,\n    y: 68,\n  },\n  {\n    id: \'c6_kurinec\',\n    stageIndex: 3,\n    name: \'Eva\',\n    role: \'Zelen\303\241 voda\',\n    quote: \'Voda Rimavy spoma\304\276uje \342\200\223 vyu\305\276i such\303\251 cyklomosty!\',\n    x: 124,\n    y: 140,\n  },\n  // Stage 5: Gemersko-malohontsk\303\251 m\303\272zeum\n  {\n    id: \'c7_museum\',\n    stageIndex: 4,\n    name: \'Martin\',\n    role: \'Kronik\303\241r Gemera\',\n    quote: \'Rymos Zumbota 1270. Aj vtedy sa tu za\304\215\303\255nalo nie\304\215o ve\304\276k\303\251.\',\n    x: 84,\n    y: 92,\n  },\n  // Stage 6: Hlavn\303\251 n\303\241mestie \302\267 Plaketa MVP\n  {\n    id: \'c8_square\',\n    stageIndex: 5,\n    name: \'Zuzka\',\n    role: \'Hlavn\303\251 n\303\241mestie RS\',\n    quote: \'Free Wi-Fi na n\303\241mest\303\255? To bude Sign\303\241lik!\',\n    x: 92,\n    y: 148,\n  },\n  {\n    id: \'c9_square\',\n    stageIndex: 5,\n    name: \'Luk\303\241\305\241\',\n    role: \'Fan\303\272\305\241ik Didaktiku\',\n    quote: \'Poraz Ve\304\276k\303\251ho Ru\305\241i\304\215a a odnes Radovi plaketu na p\303\263dium!\',\n    x: 164,\n    y: 148,\n  },\n];\n\nexport function createCitizenSpeechState(): CitizenSpeechState {\n  return {\n    activeCitizenId: null,\n    activeName: \'\',\n    activeQuote: \'\',\n    timer: 0,\n    cooldowns: {},\n  };\n}\n\nexport function getCitizensForStage(stageIndex: number): CitizenNpc[] {\n  return STAGE_CITIZENS.filter((c) => c.stageIndex === stageIndex);\n}\n\n/**\n * Pure proximity & 3-second speech timer updater for stage NPC citizens.\n */\nexport function updateCitizenSpeech(\n  stageIndex: number,\n  playerX: number,\n  playerY: number,\n  dt: number,\n  state: CitizenSpeechState,\n  citizens: readonly CitizenNpc[] = STAGE_CITIZENS\n): CitizenSpeechState {\n  // Decay cooldowns\n  for (const id of Object.keys(state.cooldowns)) {\n    state.cooldowns[id] = Math.max(0, state.cooldowns[id] - dt);\n  }\n\n  // Decay active speech timer\n  if (state.timer > 0) {\n    state.timer = Math.max(0, state.timer - dt);\n    if (state.timer <= 0) {\n      state.activeCitizenId = null;\n      state.activeName = \'\';\n      state.activeQuote = \'\';\n    }\n  }\n\n  // Trigger speech when player approaches an available citizen on current stage\n  for (const npc of citizens) {\n    if (npc.stageIndex !== stageIndex) continue;\n    const dist = Math.hypot(playerX - npc.x, playerY - npc.y);\n    const cd = state.cooldowns[npc.id] ?? 0;\n    if (dist <= CITIZEN_TRIGGER_RADIUS && cd <= 0 && state.activeCitizenId !== npc.id) {\n      state.activeCitizenId = npc.id;\n      state.activeName = npc.name;\n      state.activeQuote = npc.quote;\n      state.timer = CITIZEN_SPEECH_DURATION;\n      state.cooldowns[npc.id] = CITIZEN_RETRIGGER_COOLDOWN;\n      break;\n    }\n  }\n\n  return state;\n}\n"
    num_lines: 177
