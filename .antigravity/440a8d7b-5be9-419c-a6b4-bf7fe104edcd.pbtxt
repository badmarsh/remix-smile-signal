    content: "import assert from \'node:assert/strict\';\nimport test from \'node:test\';\nimport { createWorld, loadStage, setCoopMode, stepWorld } from \'./engine\';\nimport { InputState } from \'./types\';\n\nconst IDLE: InputState = {\n  up: false,\n  down: false,\n  left: false,\n  right: false,\n  fireJustPressed: false,\n  fireHeld: false,\n};\n\ntest(\'2P Co-op allows Player 2 (Sign\303\241lik) to move independently and fire twin signal_wave bolts while Player 1 controls Z\303\272bok\', () => {\n  const world = createWorld(\'playing\');\n  setCoopMode(world, true);\n\n  assert.equal(world.coopEnabled, true);\n  assert.equal(world.player.activeHero, \'zubok\', \'P1 should be Z\303\272bok in 2P co-op\');\n\n  const startP1X = world.player.x;\n  const startP2X = world.player.partnerX;\n\n  // Move ONLY Player 2 to the right and fire P2\'s Sign\303\241lik twin wave\n  stepWorld(world, 0.05, {\n    ...IDLE,\n    p2: { up: false, down: false, left: false, right: true, fireJustPressed: true },\n  });\n\n  assert.equal(world.player.x, startP1X, \'P1 must stay still when only P2 moves\');\n  assert.ok(world.player.partnerX > startP2X + 1, \'P2 must move independently to the right\');\n\n  const waves = world.projectiles.filter((pr) => pr.fromPlayer && pr.kind === \'signal_wave\');\n  assert.equal(waves.length, 2, \'P2 Sign\303\241lik should fire twin signal_wave projectiles\');\n});\n\ntest(\'2P Co-op lets Player 1 and Player 2 defeat Stage 6 Boss Ve\304\276k\303\275 Ru\305\241i\304\215 together without swapping\', () => {\n  const world = createWorld(\'playing\');\n  setCoopMode(world, true);\n  loadStage(world, 5, false); // Stage 6 Finale\n\n  assert.ok(world.boss);\n  // Skip F1 by restoring all targets\n  for (const t of world.targets) t.restored = true;\n  stepWorld(world, 0.02, IDLE);\n  assert.equal(world.boss.phase, 2);\n\n  // Move Boss straight to F3 (as if P1 destroyed weak spots)\n  world.boss.phase = 3;\n  world.boss.hp = 1;\n  world.boss.state = \'move\';\n  world.boss.x = 128;\n  world.boss.y = 96;\n\n  // Position P2 (Sign\303\241lik) right next to Boss and fire twin wave to bubble Boss\n  world.player.partnerX = 110;\n  world.player.partnerY = 96;\n  world.player.partnerFacing = \'right\';\n  stepWorld(world, 0.02, {\n    ...IDLE,\n    p2: { up: false, down: false, left: false, right: false, fireJustPressed: true },\n  });\n  for (let i = 0; i < 6; i++) {\n    stepWorld(world, 0.02, IDLE);\n  }\n  assert.equal(world.boss.state, \'bubbled\', \'P2 Sign\303\241lik twin wave should bubble Boss in Phase 3\');\n\n  // Wait past 0.15s self-pop grace, then P1 Z\303\272bok laser pops the bubbled boss!\n  for (let i = 0; i < 12; i++) {\n    stepWorld(world, 0.02, IDLE);\n  }\n  world.player.x = 112;\n  world.player.y = 96;\n  world.player.facing = \'right\';\n  world.player.fireCooldown = 0;\n  stepWorld(world, 0.02, { ...IDLE, fireJustPressed: true });\n  for (let i = 0; i < 8; i++) {\n    stepWorld(world, 0.02, IDLE);\n  }\n  assert.equal(world.boss.phase, 4, \'Teamwork between P2 Sign\303\241lik and P1 Z\303\272bok defeats Ve\304\276k\303\275 Ru\305\241i\304\215!\');\n});\n"
