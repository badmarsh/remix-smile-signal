      thinking_signature: "\022\333\004\n\330\004\001i\024}\023e\372\374\345\225\250\004}\241\265\244\330\307\372\230L\n`\267\275+\024f\340\210\323\344#\207a\205&D\342\320\207E\"p\340\351u\366\325\237al\222{\273nC\271\224\344\232\2416\315\247R\357D\325\210\232U\177\020P\017\031\214X\357\326\361!\353\267\300\b\021\231\354m\b\362\n\345wk\020V|d\353#M\bG\232\2520z\272i\202\332P\021\361\276\000\373@l\205\251\353n\200\360\344\266\020J<\315\177\241!\350}\3413JNxT\017S\b\220\361\242\000)|\351O\360\2040C\302y\342\022\341|\333\330\ri\252\366X\vL\307\234\211\021\225y\312\033\233\204\214=\366+\353\361S\250_\n=7\311\224\367\375\005\306(\346\351w\324\255\267?\217t\374y`l*\003\270\276K\356\217\032\211\224\250\3206]\035k;\213+wP\312OS\255\373+\025\314\305\350\355\252\227\365\2077|\247\303\352vC[\343\330\261~\354\223H\213\202\005\372\275\374\255\262R\305+IQpyyf\235=\356c7\222\232\031Q\310\273\225\243\320|\312\275\317X\243\034\221#@\303\032\036\224\277TH$\373\230\362|\363\2031D\354;T6:\264\240\b\266\274\3646.f\3139\203z\020\377*B\320\336\b\271\357\301\337\377\304l\240\223\303\'TL$\364\235\240H-q\250\357\033\246T\265z\025.w\036\ai\327\237\b5]\300\vly\256m\254\255{l\265\345`\340\272\212\016\305^\231Yi\221\2218\202\255-@\021A\217,\271\375\231\311M\226\266L\346\360Oc\377\324\b\373K\363\347\371n\023E\365\245;\376\231x\215\322@j\225\217|\361\214\327\273\241\aX\000F\364\236AT\203\210|+\343\037J\270\252\264\327&\267\036\003\216\264\211\357\235\323\365\340\322\210\004\236\213h\230\t\373\001\307l\357\213\346-\234DB\207\214\301$\202\\m\022\266\346\330\035\315\370E\354Y\023\027\003\265\200\337\327\221\355\217\303\256\247\212\266\271J\031F\310\267\241\330!\265V\305_\310\244H\203D=\210\320\354\276\356$0V\r\2127\206\037\0225/5$\004=\233\016\235\006\350 \2537\243\335\266\004\004\211\247\0301"
