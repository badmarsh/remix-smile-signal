    content: "/**\n * Osobn\303\275 text venovania pre Rada Cegl\303\251dyho.\n * TODO: Uprav texty ni\305\276\305\241ie pod\304\276a vlastn\303\251ho \305\276elania pred fin\303\241lnym odovzdan\303\255m dar\304\215eka.\n */\n\n/** Kr\303\241tky text venovania zobrazen\303\275 strojopisom po\304\215as 256\303\227192 cutsc\303\251ny odovzdania plakety. */\nexport const HANDOVER_DEDICATION_LINES: string[] = [\n  \'RADO, \304\216AKUJEME ZA TVOJU ENERGIU,\',\n  \'\304\275UDSKOS\305\244 A ODVAHU MENI\305\244 N\303\201\305\240 REGI\303\223N.\',\n  \'1. MIESTO: CELO\305\275IVOTN\303\235 MVP REGI\303\223NU!\',\n  \'S \303\232CTOU \342\200\224 OB\304\214ANIA RIMAVSKEJ SOBOTY.\',\n];\n\n/** Dlh\303\275 osobn\303\275 odkaz ob\304\215anov v Tajnej miestnosti 1270 (odomknutej tajn\303\275m k\303\263dom z plakety). */\nexport const SECRET_ROOM_TITLE = \'Tajn\303\241 miestnos\305\245 1270 \302\267 Rymos Zumbota\';\n\nexport const SECRET_ROOM_PARAGRAPHS: string[] = [\n  \'Mil\303\275 Rado, ak \304\215\303\255ta\305\241 tieto riadky, rozl\303\272\305\241til si k\303\263d z pam\303\244tnej plakety a vst\303\272pil si do tajnej komnaty z roku 1270 \342\200\224 presne v duchu dobrodru\305\276stiev z \303\251ry Didaktiku M, Towdieho a Dizzyho.\',\n  \'TODO: Sem dopl\305\210 vlastn\303\275 osobn\303\275 odkaz skupiny ob\304\215anov regi\303\263nu Rimavsk\303\241 Sobota \342\200\224 spolo\304\215n\303\251 z\303\241\305\276itky, intern\303\251 vtipy, po\304\217akovanie za microDENT, TeatrO a v\305\241etko, \304\215o pre mesto a \304\276ud\303\255 rob\303\255\305\241.\',\n  \'Nech ti t\303\241to hra a magnetick\303\241 kazeta pripom\303\255naj\303\272, \305\276e tvoja pr\303\241ca, nad\305\241enie pre nov\303\251 technol\303\263gie aj \304\276udsk\303\275 pr\303\255stup zanech\303\241vaj\303\272 v Rimavskej Sobote trval\303\272 stopu. \305\240\305\245astn\303\251 a vesel\303\251 Vianoce!\',\n];\n\n/** Deterministick\303\275 z\303\241klad, z ktor\303\251ho sa vypo\304\215\303\255ta 8-znakov\303\275 tajn\303\275 k\303\263d na plakete a karte. */\nexport const SECRET_CODE_SEED = \'RYMOS-ZUMBOTA-1270-RADO-CEGLEDY-MVP\';\n"
