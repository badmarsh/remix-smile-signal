              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "  world.player.partnerY = stage.playerStart.y;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "  world.player.partnerFacing = \'right\';"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
