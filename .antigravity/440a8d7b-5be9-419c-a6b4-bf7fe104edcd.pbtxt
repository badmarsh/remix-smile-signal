      arguments_json: "{\"Description\":\"Add compact 1P / 2P Co-op toggle and simultaneous dual-hero badge in GameHud.tsx\", \"Instruction\":\"Add onToggleCoop prop, show dual heroes in center indicator when coopEnabled, and add compact 1P/2P button beside Melodik AY\", \"ReplacementChunks\":[{\"AllowMultiple\":false, \"EndLine\":17, \"ReplacementContent\":\"  onToggleMute: () => void;\\n  onToggleChipMode: () => void;\\n  onToggleCoop: () => void;\\n  onToggleCrt: () => void;\", \"StartLine\":11, \"TargetContent\":\"  onToggleMute: () => void;\\n  onToggleChipMode: () => void;\\n  onToggleCrt: () => void;\"}, {\"AllowMultiple\":false, \"EndLine\":60, \"ReplacementContent\":\"  onToggleMute,\\n  onToggleChipMode,\\n  onToggleCoop,\\n  onToggleCrt,\", \"StartLine\":54, \"TargetContent\":\"  onToggleMute,\\n  onToggleChipMode,\\n  onToggleCrt,\"}, {\"AllowMultiple\":false, \"EndLine\":143, \"ReplacementContent\":\"          <button\\n            type=\\\"button\\\"\\n            tabIndex={-1}\\n            aria-label={\\n              hud.coopEnabled\\n                ? \'Akt\303\255vny re\305\276im 2P Co-op (H1 Z\303\272bok a H2 Sign\303\241lik)\'\\n                : \'Prepn\303\272\305\245 hrdinu medzi Z\303\272bkom a Sign\303\241likom (C)\'\\n            }\\n            title={\\n              hud.coopEnabled\\n                ? \'2P Co-op: H1 Z\303\272bok (WASD+Medzern\303\255k) \302\267 H2 Sign\303\241lik (\305\240\303\255pky+Enter)\'\\n                : \'Prepn\303\272\305\245 hrdinu [C]: Z\303\272bok (Laser) / Sign\303\241lik (Bublina)\'\\n            }\\n            onClick={(e) => {\\n              e.currentTarget.blur();\\n              if (hud.coopEnabled) {\\n                onToggleCoop();\\n              } else {\\n                onSwapHero();\\n              }\\n            }}\\n            className={`pointer-events-auto flex cursor-pointer items-center gap-2 rounded-sm border px-2.5 py-1 transition-colors ${\\n              hud.coopEnabled\\n                ? \'border-[#ffee00]/80 bg-[#1a180d]/95 text-white hover:border-[#ffee00]\'\\n                : isZubok\\n                  ? \'border-[#ff1e1e]/70 bg-[#1c1015]/95 text-white hover:border-[#ff1e1e]\'\\n                  : \'border-[#00e8e8]/70 bg-[#0d1c24]/95 text-white hover:border-[#00e8e8]\'\\n            }`}\\n          >\\n            {hud.coopEnabled ? (\\n              <div className=\\\"flex items-center gap-1\\\">\\n                <PixelSpriteIcon sprite={SPRITE_ZUBOK_A} size={20} />\\n                <PixelSpriteIcon sprite={SPRITE_SIGNALIK_A} size={20} />\\n              </div>\\n            ) : (\\n              <PixelSpriteIcon\\n                sprite={isZubok ? SPRITE_ZUBOK_A : SPRITE_SIGNALIK_A}\\n                size={22}\\n              />\\n            )}\\n            <div className=\\\"text-left leading-tight\\\">\\n              <div className=\\\"font-mono text-[11px] font-bold whitespace-nowrap\\\">\\n                {hud.coopEnabled ? \'2P CO-OP [2]\' : isZubok ? \'Z\303\272bok [C]\' : \'Sign\303\241lik [C]\'}\\n              </div>\\n              <div className=\\\"font-mono text-[9px] text-[#9aa5b8] whitespace-nowrap\\\">\\n                {hud.coopEnabled\\n                  ? \'H1 WASD \302\267 H2 \305\240\303\255pky\'\\n                  : isZubok\\n                    ? \'CEREC laser\'\\n                    : \'Wi-Fi bublina\'}\\n              </div>\\n            </div>\\n          </button>\", \"StartLine\":114, \"TargetContent\":\"          <button\\n            type=\\\"button\\\"\\n            tabIndex={-1}\\n            aria-label=\\\"Prepn\303\272\305\245 hrdinu medzi Z\303\272bkom a Sign\303\241likom (C)\\\"\\n            title=\\\"Prepn\303\272\305\245 hrdinu [C]: Z\303\272bok (Laser) / Sign\303\241lik (Bublina)\\\"\\n            onClick={(e) => {\\n              e.currentTarget.blur();\\n              onSwapHero();\\n            }}\\n            className={`pointer-events-auto flex cursor-pointer items-center gap-2