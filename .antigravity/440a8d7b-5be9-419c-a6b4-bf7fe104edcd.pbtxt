      thinking_signature: "\022\231\r\n\226\r\001i\024}\023\253\351+~\201\254I\250X\277\030C\304\321\337(=W}5\300\205\307\255\261{\265\317\255\307\320\254\303\236uP]e\201\177\354o\250\331M\217\257\325K\22407\211|\024\273\335\352\244O\316d\033d\260s\352\236\262\344H\231Et\266\340\033\231\363n\200\272\237\267\206-@%\214\001$-W=\376\335t\032\314\' P\303\000zx\274\246\002\251\250\272\242\315\277\370\341;J\221X\304#\373\227S\370\215\326\251\310a\315Q\236\320\371\3679z\375\200*/R&\321bQ\376\334d\311\017U\243\322\371\bWS\225\331\223 \001\231C3\244\3368xw\233\335u\313\252\365\370~.\246\370v\215\367\3512\247W\022\304:c\002\215\006\f\221\027`S7s\001c\351Q\032\036\200ZE\016\037\305\367\302a\256_\250\317\336\036\000\356\345\335a\003\023\200\306\v\347\321\374\324^\020\b\177+\335\202]v\254\265\314\021\367WTm32S\177M\0207\020\327:\316\366\267\376\016\303\231\232\201J\313\v\275V#<$;m\216\226\365$\321-\332\340\030\023t8\372\220\353r\301L\234 \376\317\177\324\334\303\331\346\315c[\320\3254\'\035\335\301>8a\230\371\350j:\a%9\355\330tqWU5v\036D\312\354\352\373\3778*\203d\3634\305\006\326\247\231\220o\356\350\024\270\253g\253\317 m\257]\337\334\332]\336\001jn\274\272F\255\222\0018\375\332\310w\334\216w.\v\346\2439~\202\f\0300\342Y\035w\305,LO\320\341\241K\356\312lk\375T\207z[6\365\332\263\001{\375\365\341#\335\217;\232\037\3221\217\371#\274\331\200\177O\243\230\227D\315\000\212$\351\255\026O\317nq0%<\1775\034%\326Qi\334\354@g\356\230\307l\315\304=\332*]\376\3231]\302\245\350\304\376H\277F<f\346\021\374\361v\002\006A\354\203;\251\315:\005.\324\310\361\235d\310\212\346\362,2Hg\234\261\244[\320`\271IW\034B\261(6\v\377\245#\320\361\027\031\315g\372\f\'\031\212Mg\322f[\221y\\\227\004T\216\356~W5\212\257\305^\217f\365\000\277%@C\332iL\247(KBj\245\335\337\267\'\302\025C\203<f\017\240\327/#\214\245\250\376\241~\033\256\017s\357\016:\373\371\302\004\244\264\326#F\326\276-\327\320E\257\v\232\016M0\367;77\225\366\313l\304\"\202\304:\017\037\031\321t\352\006qCW\262\'\221XU*\036\177\376\037\255\361-\211\332xQ\307\262\304\316\214\0041\334!\210)\001\023>c\017^\302\351\303z{l\304|\304\336m*V\342\364\f\211\'\312\311\321D\371\213\311\027\252\323\361\361\260\366\234\274HQ9d\t\326\214\205\033\003\352\240Li\301\256Az\023\001\255\021\365\302\036\343\337\033>\340s\243=@a\230\234(.3Q\217\027\252\237\213\332F\035\033\273p\324\343\311.3sW\216O\n{\357s\026\321\241}8\237\306p\220\t\203\f@\226\250\372\346\237\233\034\214L\002\201\274|\307XAT\177\'m\371a\260f\342;7p\002\357LI\212mC8\222\264o\027\2501\337R]%\206\2176\266\031\017F&\273\331\177\317\314r\263\261\240>G\256\271\232\341\177a\307\177\005\3140\343\336\v\'\031\206\315g\343\322\001\300M\026\223\351\032\362DZn\035D\323b{\330a\217q\366\251t)\366\001\317u\210\342\275\004J\331g\003iI\272J\022\245\2569\314\253\271\243\243\346:\365\016G\322K\332\236QA[Ix\237\200\\\214\221E\263j7L\232Pp\371\2127\262\345G\343#\366\375\f\0003\346j\332\307\036\305FjmgVW\a\363\363R\336A2N\307(\274??\253w\'\214G\032d\370j \364\265{4\364h\030\340\\\\X\375\245\270\323k-\036\321\223<\217\272\2674\v\311\224\324\323\324\337\251\336\260\247O\211eI\310@(\201F\033\2173{\260\220l\030k1D\343\f\2256\375\271\3118\205\353\276A\207$\260\271&|\f\204j\236g\0161f\234\245\327\325\277O\346h\006(v`e\214\004\214\030\006P0\004\273To\036\264\303\367\311)\370\266\212\247*\213\342]\242\201\315\336zg\205\271\342\324\v\254\275f`\370m`\321m\336\r\361vc,\003\023\001\"\377\341\375\246\"\254\335\234\341\310\274\023\327$\356\225>\322\221\360\343\267\370\267\a\345.\037\362\336\364K\201\330\257Q\256\276\247\222\230\240\376\242\251F!\240\322\270\234\233\321RT${\r\034\343\325\033\023\034\373\301\201\274\210\373\006\225*\232\020\310\341\325[\351]\252\313n\316\343`~$\033l\247\036\027\0173l\3519\326\265\221\276\3237\020z\370^4\250u\250\215N\317\237~f I\222\363Mj]\275\005Q\372k\252i\274\006\256f\276\351\347\034y\202/\031B\214\021\262M\r\312\306\263S\315\a\200x@5\232\034]8\301\262b\300\016\260!\r}D\227\222\355xSu\376x\376\232\224\005\241\316\363\263\276\240\032Y\031\2013\277\363\360\355\"X%\302_\374\343\231\333\021\212\224Jc\a-\353l\2354Y\251\"\265\365\327\003]\212\316\351\312\305=J\024\027w\227\243\323G\323\240\217\254\322F\255\236q\020F\267\017\362\243Mx\210\273\272\331IR\'\205{Rrw:j\030^U\027\347\355\242\362\267\360;\244--\310\031\331\001\236+\215=\004\2307\0002\3444qmw\376-\374\265\344Z<`H\306\376\v1tH\022\312_\243\203\303x\250gO\202\243\2148N\r\003\326b\357]\250\303\356\372\353P#\201\257\002CA\270\305\266\305k\377\246\314\257%\037\001`\217\302\33116\022\301\237\311}{\274\203h%\200/U\334\027S\266\327\257\3608\213xX\226?\313\263\344\024b\025B\353\315\177\366X\303=\241\204\355\372\312.S]\237_~i,\241\243\314j-^\257T\237\332\256i\221+\320f\270\302\317\265\337\255\202\033\205-5\204\333\302Z\261\244V\204\211d\367:\217\a\026\367\377\244u\353\365\023\363^K\236\225aN\253\321\215\372d\034\214\371\2070\327\226\265]\023\321\020p\251"
