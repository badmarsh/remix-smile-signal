          replacement_content: "import { CITIZEN_SIGNATURES, formatSignaturesAsBasicData } from \'../data/signatures\';\nimport { DEFAULT_TAPE_CONFIG } from \'./basicSource\';\nimport {\n  buildDeluxeTapFile,\n  buildTapFile,\n  decodeWavToBlocks,\n  encodeTapeToWav,\n  parseTap,\n} from \'./tapeBuilder\';\nimport { computeZxAttributeByte } from \'./udgAssets\';"
