  view_file {
    absolute_path_uri: "file:///src/didaktik/specs.ts"
    end_line: 111
    content: "/**\n * Authentic Didaktik M (Didaktik Skalica, Czechoslovakia, 1990-1993)\n * hardware parameters and ZX Spectrum 48K 15-color palette.\n */\n\nexport interface HardwareSpec {\n  label: string;\n  value: string;\n  detail: string;\n}\n\nexport const DIDAKTIK_SPECS: HardwareSpec[] = [\n  {\n    label: \'Procesor\',\n    value: \'Zilog Z80A @ 4,0 MHz\',\n    detail: \'8-bitov\303\275 procesor (mierne vy\305\241\305\241\303\255 takt ne\305\276 p\303\264vodn\303\275 3,5 MHz ZX Spectrum)\',\n  },\n  {\n    label: \'Pam\303\244\305\245\',\n    value: \'48 KiB RAM / 16 KiB ROM\',\n    detail: \'64 KiB fyzickej DRAM (16 KiB tienen\303\275ch ROM) + upraven\303\275 Sinclair BASIC ROM\',\n  },\n  {\n    label: \'Obraz ULA\',\n    value: \'Angstrem T34VG1 (256 \303\227 192)\',\n    detail: \'32 \303\227 24 atrib\303\272tov\303\275ch buniek (8 \303\227 8 px), 15 farieb, \305\241tvorcov\303\275 pomer pixelov 1:1\',\n  },\n  {\n    label: \'Zvuk\',\n    value: \'1-bitov\303\275 bzu\304\215iak + modul Melodik (AY-3-8912)\',\n    detail: \'Port 0xFE (Sinclair BASIC BEEP) a volite\304\276n\303\275 3-kan\303\241lov\303\275 hudobn\303\275 modul Didaktik Melodik\',\n  },\n  {\n    label: \'Kazeta (MG)\',\n    value: \'5-pinov\303\275 DIN konektor Magnetof\303\263n\',\n    detail: \'\305\240tandardn\303\275 Sinclair FSK/PWM kazetov\303\275 protokol (~1500 baud), podpora .TAP a .WAV\',\n  },\n  {\n    label: \'Ovl\303\241danie\',\n    value: \'45 kl\303\241vesov + samostatn\303\251 \305\241\303\255pky\',\n    detail: \'Klasick\303\251 \305\241\303\255pky v tvare T a samostatn\303\251 porty pre Kempston a Sinclair joystick\',\n  },\n];\n\n/**\n * Exact 15-color ZX Spectrum / Didaktik M palette\n * Indices 0-7: Normal (BRIGHT 0), Indices 8-15: Bright (BRIGHT 1)\n */\nexport const ZX_PALETTE = {\n  // Normal (BRIGHT 0)\n  black: \'#000000\',\n  blue: \'#0000C8\',\n  red: \'#C80000\',\n  magenta: \'#C800C8\',\n  green: \'#00C800\',\n  cyan: \'#00C8C8\',\n  yellow: \'#C8C800\',\n  white: \'#C8C8C8\',\n  // Bright (BRIGHT 1)\n  brightBlack: \'#000000\',\n  brightBlue: \'#0022FF\',\n  brightRed: \'#FF1E1E\',\n  brightMagenta: \'#FF22FF\',\n  brightGreen: \'#1AE62A\',\n  brightCyan: \'#00E8E8\',\n  brightYellow: \'#FFEE00\',\n  brightWhite: \'#FFFFFF\',\n} as const;\n\nexport const ZX_BORDER_COLORS = [\n  ZX_PALETTE.black,\n  ZX_PALETTE.blue,\n  ZX_PALETTE.red,\n  ZX_PALETTE.magenta,\n  ZX_PALETTE.green,\n  ZX_PALETTE.cyan,\n  ZX_PALETTE.yellow,\n  ZX_PALETTE.white,\n] as const;\n\nexport interface DinPin {\n  pin: number;\n  signal: string;\n  description: string;\n}\n\nexport const MG_DIN_PINOUT: DinPin[] = [\n  { pin: 1, signal: \'MIC (V\303\275stup)\', description: \'V\303\275stup SAVE z Didaktiku M do vstupu magnetof\303\263nu\' },\n  { pin: 2, signal: \'GND (Zem)\', description: \'Spolo\304\215n\303\241 zvukov\303\241 zem / tienenie k\303\241bla (stredn\303\275 pin)\' },\n  { pin: 3, signal: \'EAR (Vstup)\', description: \'Zvukov\303\275 vstup z kazetov\303\251ho prehr\303\241va\304\215a alebo PC pre LOAD \"\"\' },\n  { pin: 4, signal: \'MIC Alt\', description: \'Alternat\303\255vny v\303\275stupn\303\275 pin na vybran\303\275ch rev\303\255zi\303\241ch dosiek zo Skalice\' },\n  { pin: 5, signal: \'EAR Alt\', description: \'Alternat\303\255vny vstupn\303\275 pin \342\200\224 pripojte \305\241pi\304\215ku 3,5 mm jacku cez 10 k\316\251 rezistor\' },\n];\n\nexport const LOAD_STEPS = [\n  {\n    step: \'01\',\n    title: \'Pripojte audio k\303\241bel do portu MG\',\n    text: \'Zapojte k\303\241bel 3,5 mm jack \342\206\222 5-pin DIN zo sl\303\272chadlov\303\251ho v\303\275stupu PC (alebo nahran\303\251ho magnetof\303\263nu) do zadnej z\303\241suvky MG. Hlasitos\305\245 nastavte na 75\342\200\22385 % bez ekvaliz\303\251ra.\',\n  },\n  {\n    step: \'02\',\n    title: \'Nap\303\255\305\241te LOAD \"\" na Didaktiku M\',\n    text: \'Stla\304\215te kl\303\241ves J (nap\303\255\305\241e LOAD), podr\305\276te SYMBOL SHIFT a dvakr\303\241t stla\304\215te P (nap\303\255\305\241e \"\"), potom stla\304\215te ENTER. Okraj obrazovky sa zmen\303\255 a po\304\215\303\255ta\304\215 \304\215ak\303\241 na sign\303\241l.\',\n  },\n  {\n    step: \'03\',\n    title: \'Spustite kazetu alebo prehr\303\241vanie z PC\',\n    text: \'Stla\304\215te Play na magnetof\303\263ne alebo kliknite na Prehra\305\245 zvuk kazety v tomto \305\241t\303\272diu. Objavia sa \304\215erveno-az\303\272rov\303\251 pruhy pilotn\303\251ho t\303\263nu a n\303\241sledne modro-\305\276lt\303\251 d\303\241tov\303\251 pruhy. Hra sa sama spust\303\255 od riadku 10.\',\n  },\n];\n"
    num_lines: 112
